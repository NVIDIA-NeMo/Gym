# GLM-5.2 (fp8), throughput shape: 7 replicas across 7 nodes.
#
# Target for the production DP-scaling check. The single-replica fp8 profile
# (TP=8 over 2 nodes) sustained an inferred ~662 aggregate output tok/s at agent
# concurrency 16, and measured aggregate throughput was still scaling at ~0.84
# efficiency per doubling with no sign of flattening — so serving, not the agent
# loop, was the binding constraint.
#
# Topology choice: TP=4 with one replica per node, NOT TP=8 spanning two nodes.
#   * This cluster has 4 GPUs per node, so TP=4 keeps a replica inside one node
#     and avoids cross-node tensor parallelism on the hot path.
#   * It mirrors the bf16 profile (TP=4, DP=N, DPL=1), which is a proven topology
#     here. Since bf16 weights already fit at TP=4, fp8 fits comfortably with
#     more room left for KV cache.
#   * 7 nodes instead of 14 for the same replica count: cheaper and far more
#     likely to schedule.
#
# Pair with agent concurrency ~112 (16 per replica). Concurrency must feed the
# replicas or the extra capacity sits idle.

export GDPVAL_MODEL_BASE_NAME="GLM-52-fp8-dp7"

export GDPVAL_NUM_NODES="7"
export GDPVAL_TENSOR_PARALLEL_SIZE="4"
export GDPVAL_PIPELINE_PARALLEL_SIZE="1"
export GDPVAL_DATA_PARALLEL_SIZE="7"
export GDPVAL_DATA_PARALLEL_SIZE_LOCAL="1"
export GDPVAL_GPU_MEMORY_UTILIZATION="0.90"
export GDPVAL_API_SERVER_COUNT="1"
export GDPVAL_MAX_MODEL_LEN="262144"

export GDPVAL_TOOL_CALL_PARSER="glm47"
export GDPVAL_REASONING_PARSER="glm45"
export GDPVAL_KV_CACHE_DTYPE="fp8"
export GDPVAL_EXPERT_PARALLEL="1"
export GDPVAL_ENFORCE_EAGER="0"
# 7 replicas against agent concurrency ~112 is ~16 sequences per replica. 128 is
# ample headroom and, being explicit, means the container default cannot quietly
# become the throughput ceiling.
export GDPVAL_MAX_NUM_SEQS="128"
# Left at the vLLM default: prefill is ~1% of model time on this workload, so the
# prefill/decode token budget is not where throughput is won or lost.
export GDPVAL_MAX_NUM_BATCHED_TOKENS=""

export GDPVAL_VLLM_EXTRA_ARGS=""
