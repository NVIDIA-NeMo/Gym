# Mercor OTS 200-task GDPVal dataset (2026-07-22).
#
# Source it via GDPVAL_ENV_FILE alongside the private env, e.g.
#   GDPVAL_ENV_FILE=/path/to/mercor_ots_200_20260722.env run_gdpval_rollouts.sh preflight
#
# Verified against benchmarks/gdpval/validate_gdpval_batch.py: the file is
# schema-identical to the AfterQuery batch (same 9 keys, same
# responses_create_params={"input": []}). Two dataset-specific differences are
# handled by the knobs below rather than by editing the pipeline:
#   * task_id is `task_<32 hex>` instead of AfterQuery's `AQ-#####`
#   * reference_file_urls are absolute lustre paths, not HTTPS URLs
#     (573/573 confirmed present on disk)
# `sector` is empty on all 200 rows; the validator only requires the key to
# exist, so this passes as-is.

export GDPVAL_DATASET_NAME="mercor-ots-200-20260722"
# Staged 0600 copy of katherineh's 0644 source (sha256 verified identical), so the
# batch is handled with the same confidentiality as the AfterQuery source.
export GDPVAL_INPUT_JSONL="/lustre/fsw/portfolios/llmservice/users/spanev/afterquery-gdpval-rollouts/private_input/mercor_ots_200_20260722.jsonl"
export GDPVAL_EXPECTED_COUNT="200"
export GDPVAL_EXPECTED_SOURCE_SHA256="9a0e9812e38a514aec55c53002b955ba44771f8ea3767c054339b886b71ca55c"
export GDPVAL_TASK_ID_PATTERN='task_[0-9a-f]{32}$'
export GDPVAL_REFERENCE_MODE="local"

# The gate covers the source JSONL (and overrides), not the 573 reference files,
# which stay 0644 under katherineh's tree and are read directly at runtime.
export GDPVAL_REQUIRE_PRIVATE_FILES="true"

# No prompt-backed reference repairs are needed for this batch.
export GDPVAL_REFERENCE_OVERRIDES=""

# Run root is per-dataset so Mercor artifacts never mix with AfterQuery ones.
export GDPVAL_RUN_TAG="GLM-52-fp8_mercor-ots-200_20260722"

# Server/model identity is dataset-scoped so endpoint validation and the
# recorded response model cannot be confused with an AfterQuery run.
export GDPVAL_MODEL_BASE_NAME="GLM-52-fp8-mercor-ots-20260722"

# 250 is the GDPVal config default (and what danz runs); AfterQuery had been
# narrowed to 100. Per-turn generation is unchanged: --max-output-tokens is the
# full 262144 context and max_completion_tokens_cap stays at the 64000 agent
# default, both matching danz.
export GDPVAL_AGENT_MAX_TURNS="250"

# Set once a launch input has been produced by `preflight`, so later actions can
# prove the staged file has not drifted:
#   export GDPVAL_EXPECTED_LAUNCH_SHA256="<sha256 of the .launch.jsonl>"

# Pick any task_id from the batch as the smoke task when using the `smoke`/`run`
# actions. `full` skips the smoke entirely.
export GDPVAL_SMOKE_TASK_ID="task_d14c949c4e6840ada94413780e54f05d"
