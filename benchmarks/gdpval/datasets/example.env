# GDPVal dataset profile — template.
#
# One profile per batch. Adding a batch means adding a profile, not editing the
# orchestration scripts. Select one with GDPVAL_ENV_FILE:
#
#   GDPVAL_ENV_FILE=/path/to/my_batch.env ./run_gdpval_rollouts.sh preflight
#
# Keep real profiles outside the repo when they point at non-public inputs:
# the paths below are read from the cluster filesystem, not shipped with Gym.

# Human-readable batch id. Used in log lines and run roots.
export GDPVAL_DATASET_NAME="my-batch-2026-01-01"

# Absolute path to the batch JSONL, readable from every compute node.
export GDPVAL_INPUT_JSONL="/path/to/my_batch.jsonl"

# Row count and content hash. Both are checked before a run starts and again on
# resume, so a batch cannot silently change underneath a multi-allocation run.
export GDPVAL_EXPECTED_COUNT="200"
export GDPVAL_EXPECTED_SOURCE_SHA256=""

# Anchored regex every task_id must match. Catches a batch loaded in the wrong
# format long before the rollouts are wasted.
export GDPVAL_TASK_ID_PATTERN='task_[0-9a-f]{32}$'

# "local"  — reference_file_urls are filesystem paths, read directly at runtime
# "https"  — reference_file_urls are URLs to be fetched
export GDPVAL_REFERENCE_MODE="local"

# Require the input JSONL to be mode 0600. Set for confidential batches.
export GDPVAL_REQUIRE_PRIVATE_FILES="false"

# Optional JSON of per-task reference-file repairs, for batches whose reference
# URLs need patching. Empty when the batch needs none.
export GDPVAL_REFERENCE_OVERRIDES=""

# Run root, so artifacts from different batches never mix.
export GDPVAL_RUN_TAG="my-model_my-batch_2026-01-01"

# Served model name. Dataset-scoped so endpoint validation and the recorded
# response model cannot be confused with a different batch.
export GDPVAL_MODEL_BASE_NAME="my-model-my-batch"

# Agent turn budget. 250 is the GDPVal config default. Per-turn generation is
# unaffected by this.
export GDPVAL_AGENT_MAX_TURNS="250"

# Set after `preflight` produces a launch input, so later actions can prove the
# staged file has not drifted:
#   export GDPVAL_EXPECTED_LAUNCH_SHA256="<sha256 of the .launch.jsonl>"

# Any task_id from the batch, used by the `smoke` and `run` actions to validate
# the pipeline end-to-end before committing an allocation. `full` skips it.
export GDPVAL_SMOKE_TASK_ID=""
