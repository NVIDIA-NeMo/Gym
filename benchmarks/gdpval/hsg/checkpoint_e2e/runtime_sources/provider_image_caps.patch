+_LOSSLESS_TILE_MIME_TYPES = frozenset({"image/png", "image/jpeg"})
+
+
+def _image_data_url(block: dict) -> tuple[str, str] | None:
+    """Return ``(mime_type, base64_payload)`` for an inline image block."""
+
+    if block.get("type") != "image_url":
+        return None
+    image_url = block.get("image_url") or {}
+    url = image_url.get("url", "") if isinstance(image_url, dict) else ""
+    if not isinstance(url, str) or not url.startswith("data:image/"):
+        return None
+    header, separator, payload = url.partition(",")
+    if not separator or not header.endswith(";base64"):
+        return None
+    return header[5:-7].lower(), payload
+
+
+def _lossless_png_tiles(
+    payload: bytes,
+    *,
+    max_base64_bytes: int,
+    max_tiles: int,
+) -> tuple[list[bytes], list[tuple[int, int, int, int]], tuple[int, int]]:
+    """Split a static image into complete, non-overlapping lossless PNG tiles."""
+
+    if max_base64_bytes <= 0 or max_tiles <= 0:
+        raise ValueError("image tile limits must be positive")
+    try:
+        import fitz  # PyMuPDF
+    except ImportError as exc:
+        raise RuntimeError("PyMuPDF is required for provider image-cap tiling") from exc
+
+    try:
+        source = fitz.Pixmap(payload)
+    except Exception as exc:
+        raise ValueError(f"cannot decode static image for lossless tiling: {exc!r}") from exc
+    if source.colorspace is None or source.width <= 0 or source.height <= 0:
+        raise ValueError("static image has no tileable pixel colorspace")
+    if source.width * source.height > MAX_RASTER_PAGE_PIXELS_FOR_JUDGE:
+        raise ValueError(
+            "static image exceeds the bounded lossless tiling pixel limit: "
+            f"{source.width}x{source.height}"
+        )
+
+    def _encode(rect: tuple[int, int, int, int]) -> bytes:
+        box = fitz.IRect(*rect)
+        tile = fitz.Pixmap(source.colorspace, box, source.alpha)
+        tile.copy(source, box)
+        tile.set_origin(0, 0)
+        return tile.tobytes("png")
+
+    accepted: list[tuple[tuple[int, int, int, int], bytes]] = []
+    pending: list[tuple[int, int, int, int]] = [(0, 0, source.width, source.height)]
+    while pending:
+        rect = pending.pop()
+        encoded = _encode(rect)
+        encoded_chars = 4 * ((len(encoded) + 2) // 3)
+        if encoded_chars <= max_base64_bytes:
+            accepted.append((rect, encoded))
+            continue
+        x0, y0, x1, y1 = rect
+        width = x1 - x0
+        height = y1 - y0
+        if width <= 1 and height <= 1:
+            raise ValueError("one lossless image pixel exceeds the provider image cap")
+        if len(accepted) + len(pending) + 2 > max_tiles:
+            raise ValueError(f"lossless image tiling requires more than {max_tiles} tiles")
+        if width >= height and width > 1:
+            midpoint = x0 + width // 2
+            first = (x0, y0, midpoint, y1)
+            second = (midpoint, y0, x1, y1)
+        else:
+            midpoint = y0 + height // 2
+            first = (x0, y0, x1, midpoint)
+            second = (x0, midpoint, x1, y1)
+        # Stack order preserves the source's top/left-first visual reading order.
+        pending.extend((second, first))
+
+    return (
+        [encoded for _rect, encoded in accepted],
+        [rect for rect, _encoded in accepted],
+        (source.width, source.height),
+    )
+
+
+def apply_judge_image_byte_cap(
+    judge: Judge,
+    sections: dict[str, list[dict]],
+    *,
+    max_images: int,
+) -> tuple[dict[str, list[dict]], dict[str, Any]]:
+    """Apply a provider's individual-image cap without dropping image pixels.
+
+    Static PNG/JPEG inputs that exceed the configured base64-source limit are
+    decoded once and emitted as lossless PNG tiles. Each tile carries explicit
+    source hash, dimensions, and crop coordinates, so the judge can reconstruct
+    the original layout. Unsupported/invalid inputs fail closed before dispatch.
+    """
+
+    cap = judge.max_image_base64_bytes
+    original = {name: list(blocks) for name, blocks in sections.items()}
+    image_count = sum(
+        _image_data_url(block) is not None for blocks in sections.values() for block in blocks
+    )
+    receipt: dict[str, Any] = {
+        "enabled": cap is not None,
+        "eligible": True,
+        "max_image_base64_bytes": cap,
+        "original_image_count": image_count,
+        "output_image_count": image_count,
+        "transformations": [],
+        "reasons": [],
+    }
+    if cap is None:
+        return original, receipt
+    if cap <= 0 or max_images <= 0:
+        receipt["eligible"] = False
+        receipt["reasons"].append("invalid_image_cap_config")
+        return original, receipt
+    if image_count > max_images:
+        receipt["eligible"] = False
+        receipt["reasons"].append("provider_image_count_cap")
+        return original, receipt
+
+    available_extra_tiles = max_images - image_count
+    transformed: dict[str, list[dict]] = {}
+    try:
+        for section_name, blocks in sections.items():
+            output: list[dict] = []
+            for block_index, block in enumerate(blocks):
+                parsed = _image_data_url(block)
+                if parsed is None or len(parsed[1].encode("ascii")) <= cap:
+                    output.append(block)
+                    continue
+                mime_type, encoded_payload = parsed
+                if mime_type not in _LOSSLESS_TILE_MIME_TYPES:
+                    raise ValueError(f"oversize image MIME cannot be tiled losslessly: {mime_type}")
+                raw = base64.b64decode(encoded_payload, validate=True)
+                max_tiles = available_extra_tiles + 1
+                tiles, rectangles, dimensions = _lossless_png_tiles(
+                    raw,
+                    max_base64_bytes=cap,
+                    max_tiles=max_tiles,
+                )
+                available_extra_tiles -= len(tiles) - 1
+                source_sha256 = hashlib.sha256(raw).hexdigest()
+                tile_receipts: list[dict[str, Any]] = []
+                for tile_index, (tile, rect) in enumerate(zip(tiles, rectangles), start=1):
+                    tile_payload = base64.b64encode(tile).decode("ascii")
+                    if len(tile_payload.encode("ascii")) > cap:
+                        raise RuntimeError("lossless image tile violated its provider cap")
+                    x0, y0, x1, y1 = rect
+                    output.append(
+                        {
+                            "type": "text",
+                            "text": (
+                                f"[lossless image tile {tile_index}/{len(tiles)}; "
+                                f"source_sha256={source_sha256}; original={dimensions[0]}x{dimensions[1]}px; "
+                                f"crop=({x0},{y0})-({x1},{y1}); complete source coverage, no resizing]"
+                            ),
+                        }
+                    )
+                    output.append(
+                        {
+                            "type": "image_url",
+                            "image_url": {"url": f"data:image/png;base64,{tile_payload}"},
+                        }
+                    )
+                    tile_receipts.append(
+                        {
+                            "crop": [x0, y0, x1, y1],
+                            "raw_bytes": len(tile),
+                            "base64_bytes": len(tile_payload),
+                            "sha256": hashlib.sha256(tile).hexdigest(),
+                        }
+                    )
+                receipt["transformations"].append(
+                    {
+                        "section": section_name,
+                        "block_index": block_index,
+                        "source_mime_type": mime_type,
+                        "source_sha256": source_sha256,
+                        "source_raw_bytes": len(raw),
+                        "source_base64_bytes": len(encoded_payload),
+                        "source_dimensions": list(dimensions),
+                        "tiles": tile_receipts,
+                    }
+                )
+            transformed[section_name] = output
+    except Exception as exc:
+        receipt["eligible"] = False
+        receipt["reasons"].append("provider_image_cap_transform_failed")
+        receipt["error"] = repr(exc)
+        return original, receipt
+
+    output_count = sum(
+        _image_data_url(block) is not None for blocks in transformed.values() for block in blocks
+    )
+    receipt["output_image_count"] = output_count
+    if output_count > max_images:
+        receipt["eligible"] = False
+        receipt["reasons"].append("provider_image_count_cap")
+        return original, receipt
+    return transformed, receipt
+
