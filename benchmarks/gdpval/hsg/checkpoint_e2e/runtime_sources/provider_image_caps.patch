     component_types = {"responses_api_agents", "responses_api_models", "resources_servers"}
+    # Provider payload limits are transport compatibility, not scientific
+    # selection/evidence inputs. max_image_base64_bytes only selects a
+    # deterministic, lossless PNG representation. Larger raw/wire admission
+    # ceilings do not alter requests that already fit, so fingerprint them at
+    # the legacy ceilings to keep completed campaigns resumable. Lower ceilings
+    # remain fingerprinted because they can exclude previously eligible work.
+    # Model, prompt, trial-count, media-mode, and every other judge change stay
+    # bound to the campaign fingerprint.
+    transport_only_runtime_fields = frozenset({"max_image_base64_bytes"})
+    legacy_transport_ceilings = {
+        "max_raw_bytes": 330301440,
+        "max_wire_bytes": 440401920,
+        "max_serialized_request_bytes": 440401920,
+    }
+
+    # Runtime credentials are intentionally unbound so key rotation cannot fork a
+    # campaign; endpoint and model fields remain fingerprinted.
+    credential_runtime_fields = frozenset({"api_key", "openai_api_key"})
+
+    def without_nonsemantic_runtime_fields(value: Any) -> Any:
+        """Drop allow-listed non-semantic fields after normal JSON conversion.
+
+        Applying this only inside runtime-component serialization preserves the
+        old fingerprint byte-for-byte when the field is absent.  The same name
+        in a materialized row or rollout request remains result-affecting.
+        """
+        if isinstance(value, Mapping):
+            result: Dict[str, Any] = {}
+            for key, item in value.items():
+                key = str(key)
+                if key in transport_only_runtime_fields or key in credential_runtime_fields:
+                    continue
+                normalized = without_nonsemantic_runtime_fields(item)
+                ceiling = legacy_transport_ceilings.get(key)
+                if (
+                    ceiling is not None
+                    and isinstance(normalized, int)
+                    and not isinstance(normalized, bool)
+                    and normalized > ceiling
+                ):
+                    normalized = ceiling
+                result[key] = normalized
+            return result
+        if isinstance(value, list):
+            return [without_nonsemantic_runtime_fields(item) for item in value]
+        return value

