+
+
+_CONTEXT_WINDOW_ERROR_MARKERS = (
+    "contextwindowexceeded",
+    "context window error",
+    "input is too long for requested model",
+)
+
+
+def is_context_window_error(error: BaseException) -> bool:
+    """Recognize only provider rejections that explicitly report context size."""
+    parts: list[str] = []
+    seen: set[int] = set()
+    current: Optional[BaseException] = error
+    while current is not None and id(current) not in seen:
+        seen.add(id(current))
+        parts.append(f"{type(current).__name__}: {current!r}".lower())
+        current = current.__cause__ or current.__context__
+    message = "\n".join(parts)
+    return any(marker in message for marker in _CONTEXT_WINDOW_ERROR_MARKERS)
+

+class JudgeContextWindowError(RuntimeError):
+    """A named judge rejected an otherwise preflight-valid request as too large."""

+    def __init__(self, judge_name: str, original: BaseException) -> None:
+        self.judge_name = judge_name
+        self.original = original
+        super().__init__(f"judge {judge_name!r} exceeded its provider context window: {original}")
+
