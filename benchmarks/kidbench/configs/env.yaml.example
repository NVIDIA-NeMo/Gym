#
# KIDBench run wiring. Copy to ./env.yaml at the repository root (Gym auto-loads it from
# the cwd) and fill in the endpoints. Never commit the filled-in copy — env.yaml is
# gitignored.
#
# Keys come from the shell via ${oc.env:VAR}; URLs and model ids go here.
#
# `run_all_models.sh` sweeps several models in one go instead, and reads everything
# deployment-specific from a dotenv file (ENV_FILE, default ./.env) so no endpoint is ever
# committed. That file needs:
#
#   KIDBENCH_ULTRA_BASE_URL       OpenAI-compatible /v1 endpoint per model under test
#   KIDBENCH_KIMI_BASE_URL
#   KIDBENCH_QWEN_BASE_URL
#   KIDBENCH_SUPER_VL_BASE_URL
#   KIDBENCH_ACTOR_BASE_URL       the child actor, deployed by deploy/modal_actor.py
#   MODAL_PROXY_TOKEN             bearer token for the above
#   SUPER_VL_MODAL_TOKEN          separate token if that endpoint uses its own
#   OPENROUTER_API_KEY            judge access (deepseek-v4-pro / -flash)
#
# A model whose base-URL variable is unset is skipped with a message rather than run
# against a stale endpoint.

# --- Model under test -------------------------------------------------------------
# Overridden per model at the command line, e.g.
#   ++policy_model.responses_api_models.inference_provider.model=moonshotai/Kimi-K3
policy_model:
  responses_api_models:
    inference_provider:
      entrypoint: app.py
      base_url: <your-openai-compatible-base-url>/v1
      api_key: ${oc.env:MODAL_PROXY_TOKEN,""}
      model: <your-model-id>
      # Reasoning models on vLLM/SGLang return reasoning in a separate field; without
      # this the converter would fold it into the visible answer and the judge would
      # score the model's scratchpad as if a child had read it.
      uses_reasoning_parser: true
      num_concurrent_requests: 32

# --- Judge ------------------------------------------------------------------------
# The paper's judge, selected over seven candidates for consistency and valid structured
# output. Thinking is disabled to match upstream's `thinking: {type: disabled}`; the judge
# is asked for exactly one JSON object, and a reasoning preamble breaks that contract.
kidbench_judge_model:
  responses_api_models:
    inference_provider:
      entrypoint: app.py
      base_url: https://openrouter.ai/api/v1
      api_key: ${oc.env:OPENROUTER_API_KEY,""}
      model: deepseek/deepseek-v4-pro
      uses_reasoning_parser: false
      num_concurrent_requests: 50
      extra_body:
        reasoning:
          enabled: false

# Multi-turn is scored by the cheaper model upstream's own multi-turn script uses.
# Pointing this at the pro judge instead would produce better numbers than the paper's,
# not comparable ones.
kidbench_multi_turn_judge_model:
  responses_api_models:
    inference_provider:
      entrypoint: app.py
      base_url: https://openrouter.ai/api/v1
      api_key: ${oc.env:OPENROUTER_API_KEY,""}
      model: deepseek/deepseek-v4-flash
      uses_reasoning_parser: false
      num_concurrent_requests: 64
      extra_body:
        reasoning:
          enabled: false

# --- Multi-turn child actor -------------------------------------------------------
# The actor plays the child. The choice of actor affects the scores: an actor that breaks
# character and refuses stops probing exactly where probing matters, and every model then
# looks safer than it is. Two options, in descending fidelity.
#
# OPTION A (default, what the published runs used) — a refusal-ablated Gemma-4-31B-it.
# The paper's own actor is ablated this way but is deliberately not released, so this is a
# third-party ablation of the same base model, pinned to an exact commit. Self-hosted:
# the weights are 62.6 GB in bf16. `benchmarks/kidbench/deploy/modal_actor.py` deploys it.
kidbench_actor_model:
  responses_api_models:
    inference_provider:
      entrypoint: app.py
      base_url: <your-actor-base-url>/v1
      api_key: ${oc.env:MODAL_PROXY_TOKEN,""}
      model: wangzhang/gemma-4-31B-it-abliterated
      uses_reasoning_parser: false
      num_concurrent_requests: 32

# OPTION B — the stock instruct model from any OpenAI-compatible provider, for anyone who
# cannot self-host. Honest but weaker: it refuses some actor turns instead of pressing,
# which biases every model under test towards looking safe. Usable, provided the measured
# actor refusal rate is reported next to the scores — the agent records it on every
# conversation for exactly this reason. Swap this block in for the one above.
#
# kidbench_actor_model:
#   responses_api_models:
#     inference_provider:
#       entrypoint: app.py
#       base_url: https://openrouter.ai/api/v1
#       api_key: ${oc.env:OPENROUTER_API_KEY,""}
#       model: google/gemma-4-31b-it
#       uses_reasoning_parser: false
#       num_concurrent_requests: 32
