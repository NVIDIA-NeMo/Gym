export NEMO_GYM_USER="${NEMO_GYM_USER:-$SLURM_JOB_USER}"

source "benchmarks/nemotron_3.5_super/vllm_configs/nemotron_3.5_super_low_concurrency.sh"

gym eval prepare     --config responses_api_models/vllm_model/configs/vllm_model.yaml     --config benchmarks/nemotron_3.5_super/split50/shards/tb_r0.yaml     +use_cached_prepared_benchmarks=true

experiment_name=exp/replica_0
rollouts_fpath=results/$experiment_name/rollouts.jsonl

gym eval run     --config responses_api_models/vllm_model/configs/vllm_model.yaml     --config benchmarks/nemotron_3.5_super/split50/shards/tb_r0.yaml     --config benchmarks/nemotron_3.5_super/sandbox_utils.yaml     --config benchmarks/nemotron_3.5_super/policy_model_override.yaml     +wandb_project=tester-gym-low-concurrency     +wandb_name=$experiment_name     +uv_venv_dir=/opt/uv_venvs     +nemo_gym_log_dir=results/$experiment_name/logs     +skip_venv_if_present=true     ++output_jsonl_fpath=$rollouts_fpath     ++overwrite_metrics_conflicts=true     ++split=benchmark     ++use_absolute_ip=true     ++reuse_existing_data_preparation=true     ++resume_from_cache=true     ++num_samples_in_parallel=48     ++policy_base_url=http://$(getent hosts "$REPLICA_NODE" | awk 'NR == 1 {print $1}'):8001/v1     ++policy_api_key=dummy_api_key     ++policy_model_name=m     ++upload_rollouts=false     ++global_aiohttp_connector_limit_per_host=16384     ++port_range_low=63000     ++port_range_high=64000     ++observability_enabled=true     ++model_call_capture_dir=/opt/Gym/results/$experiment_name/model_calls     ++route_failures_to_sidecar=true     ++terminal_bench_2_1_terminus_2_sandboxed_agent.responses_api_agents.terminus_2_sandboxed_agent.sandbox_timeout=7200     "${GYM_MODEL_PARAMS[@]}"
