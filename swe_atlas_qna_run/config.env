# Shared configuration for SWE-Atlas QnA dfw run scripts.
# Edit this file once, then run the numbered scripts.

export WORKSPACE_DIR="/lustre/fsw/portfolios/llmservice/users/wasiuddina"
export GYM_DIR="${WORKSPACE_DIR}/Gym"
export GYM_CONTAINER_DIR="/workspace/Gym"
export RUN_DIR="${GYM_DIR}/swe_atlas_qna_run"
export RUN_CONTAINER_DIR="${GYM_CONTAINER_DIR}/swe_atlas_qna_run"

# Fill these before running 03_request_allocation.sh.
export SLURM_ACCOUNT="nemotron_reason_code"
export SLURM_PARTITION="batch"
export GPU_COUNT="8"
export WALLTIME="04:00:00"
export GYM_IMAGE="/lustre/fsw/portfolios/llmservice/users/wasiuddina/images/sugam-apptainer-0504.sqsh"
export VLLM_IMAGE="/lustre/fsw/portfolios/llmservice/users/igitman/images/nemo-skills-vllm-latest.sqsh"
export CONTAINER_MOUNTS="${WORKSPACE_DIR}:/workspace,/lustre:/lustre"
# Run Gym on the host allocation shell so its Apptainer sandbox provider is not
# nested inside GYM_IMAGE. vLLM still runs in VLLM_IMAGE.
export RUN_GYM_IN_CONTAINER="false"

# Cluster assets from the runbook.
export IMAGES_DIR="/lustre/fsw/portfolios/llmservice/users/igitman/images/swe-qna"
export POLICY_CKPT="/lustre/fsw/portfolios/llmservice/users/igitman/hf_models/NVIDIA-Nemotron-3-Super-120B-A12B-BF16"
export POLICY_MODEL_NAME="model"
export POLICY_API_KEY="EMPTY"
export VLLM_HOST="127.0.0.1"
export VLLM_PORT="8000"
export POLICY_BASE_URL="http://${VLLM_HOST}:${VLLM_PORT}/v1"
export VLLM_LOG="${VLLM_LOG:-${RUN_DIR}/vllm_server.log}"
export VLLM_PID_FILE="${VLLM_PID_FILE:-${RUN_DIR}/vllm_server.pid}"
export VLLM_EXTRA_ARGS="--async-scheduling --tensor-parallel-size 8 --max-model-len 262144 --enable-expert-parallel --enable-chunked-prefill --gpu-memory-utilization 0.9 --mamba-ssm-cache-dtype float16 --attention-backend FLASH_ATTN --trust-remote-code --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser-plugin ${POLICY_CKPT}/super_v3_reasoning_parser.py --reasoning-parser super_v3"

# Judge endpoint. NVIDIA_API_KEY should already be exported in your shell or set here.
export SWE_ATLAS_QNA_JUDGE_BASE_URL="https://inference-api.nvidia.com/v1"
export SWE_ATLAS_QNA_JUDGE_API_KEY="${NVIDIA_API_KEY:-}"
export SWE_ATLAS_QNA_JUDGE_MODEL="azure/anthropic/claude-opus-4-5"
export OPENAI_API_KEY="${NVIDIA_API_KEY:-}"

# Runtime knobs.
export RAY_TMPDIR="/tmp"
export UV_CACHE_DIR="${RUN_DIR}/.uv-cache"
export TMPDIR="${RUN_DIR}/.tmp"
export VLLM_TMPDIR="/tmp/vllm-${USER}"
export HF_HOME="/workspace/.hf_cache"
export HF_HUB_CACHE="${HF_HOME}/hub"
export TRANSFORMERS_CACHE="${HF_HOME}/transformers"
export VLLM_CACHE_DIR="/workspace/.vllm-cache"
export TORCH_HOME="/workspace/.torch"
export GYM_CONTAINER_HOME="/workspace"
export APPTAINER_CACHEDIR="/workspace/.apptainer/cache"
export APPTAINER_TMPDIR="/workspace/.apptainer/tmp"
export HOST_APPTAINER_CACHEDIR="${WORKSPACE_DIR}/.apptainer/cache"
export HOST_APPTAINER_TMPDIR="${WORKSPACE_DIR}/.apptainer/tmp"
# Prefer a system Apptainer in host mode. Conda/miniconda Apptainer builds often
# require unprivileged user namespaces and can fail with "Failed to enter in user namespace".
export HOST_APPTAINER_BIN="${HOST_APPTAINER_BIN:-/usr/bin/apptainer}"
export BENCHMARK_CONFIG_PATH="${GYM_CONTAINER_DIR}/benchmarks/swe_atlas_qna/config.yaml"
export HOST_BENCHMARK_CONFIG_PATH="${GYM_DIR}/benchmarks/swe_atlas_qna/config.yaml"
export PROMPT_CONFIG_PATH="${GYM_CONTAINER_DIR}/benchmarks/prompts/generic/default.yaml"
export HOST_PROMPT_CONFIG_PATH="${GYM_DIR}/benchmarks/prompts/generic/default.yaml"
export MINI_SWE_CONFIG_PATH="${GYM_CONTAINER_DIR}/responses_api_agents/mini_swe_agent_qna/configs/mswea_qa_config.yaml"
export HOST_MINI_SWE_CONFIG_PATH="${GYM_DIR}/responses_api_agents/mini_swe_agent_qna/configs/mswea_qa_config.yaml"
export POLICY_CONFIG_PATH="responses_api_models/vllm_model/configs/nemotron_super_120b_external.yaml"
export AGENT_CONFIG_PATH="swe_atlas_qna_benchmark_mini_swe_agent.responses_api_agents.mini_swe_agent_qna"
# Number of concurrent QnA rollouts. This is used both when starting the agent
# server and when dispatching eval requests from 09_run_full_eval_and_profile.sh.
export CONCURRENCY="${CONCURRENCY:-8}"
export NUM_SHARDS="${NUM_SHARDS:-4}"
export SHARD_INDEX="${SHARD_INDEX:-0}"
export SHARD_INPUT_DIR="${SHARD_INPUT_DIR:-${RUN_DIR}/shards/swe_atlas_qna_${NUM_SHARDS}}"
export SHARD_CONTAINER_INPUT_DIR="${SHARD_CONTAINER_INPUT_DIR:-${RUN_CONTAINER_DIR}/shards/swe_atlas_qna_${NUM_SHARDS}}"
export SHARD_OUTPUT_DIR="${SHARD_OUTPUT_DIR:-${GYM_DIR}/results/swe_atlas_qna_shards_${NUM_SHARDS}}"
export SHARD_CONTAINER_OUTPUT_DIR="${SHARD_CONTAINER_OUTPUT_DIR:-${GYM_CONTAINER_DIR}/results/swe_atlas_qna_shards_${NUM_SHARDS}}"
export SMOKE_PATH="${RUN_DIR}/swe_atlas_qna_smoke.jsonl"
export SMOKE_CONTAINER_PATH="${RUN_CONTAINER_DIR}/swe_atlas_qna_smoke.jsonl"
export SERVER_LOG="${SERVER_LOG:-${RUN_DIR}/gym_servers.log}"
export SERVER_PID_FILE="${SERVER_PID_FILE:-${RUN_DIR}/gym_servers.pid}"
export SMOKE_OUTPUT="${GYM_DIR}/results/swe_atlas_qna_smoke.jsonl"
export FULL_OUTPUT="${GYM_DIR}/results/swe_atlas_qna_full.jsonl"
export PROFILE_OUTPUT_DIR="${GYM_DIR}/results/swe_atlas_qna_profile"
export SMOKE_CONTAINER_OUTPUT="${GYM_CONTAINER_DIR}/results/swe_atlas_qna_smoke.jsonl"
export FULL_CONTAINER_OUTPUT="${GYM_CONTAINER_DIR}/results/swe_atlas_qna_full.jsonl"
export PROFILE_CONTAINER_OUTPUT_DIR="${GYM_CONTAINER_DIR}/results/swe_atlas_qna_profile"

# Optional troubleshooting toggles.
# Run sandbox commands as the default Apptainer user. This avoids --fakeroot,
# which fails on DFW nodes that cannot enter a user namespace.
export SANDBOX_USER_NULL="true"
# Set to true if the sandbox cannot write /sandbox/answer.txt.
export APPTAINER_WRITABLE_TMPFS="false"
