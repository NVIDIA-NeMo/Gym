+    def test_admitted_megatron_call_asks_through_offload_params(self, active_trace: CallTrace) -> None:
+        payload = {"offload_params": {NG_CAPTURE_FIELD: {"rollout_id": "r"}}}
+        request_engine_token_data(payload, megatron_engine=True)
