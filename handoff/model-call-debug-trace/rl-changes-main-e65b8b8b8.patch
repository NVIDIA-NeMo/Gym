+def _stamp_trace_rollout_ids(nemo_gym_examples: list[dict]) -> None:
+    """Give each row a Gym rollout id, so its model calls carry ``/ng-rollout/<id>``.
+
+    Token capture stamps its gate-registered ids. Without it, Gym's model-call
+    debug trace would record every call with no rollout to group it by. The id
+    joins the group, generation index, and group attempt that the rollout
+    manager stamps on every row, so a retried group gets fresh ids.
+    """
+    for row in nemo_gym_examples:
+        if row.get(_NG_ROLLOUT_ID_BODY_KEY):
+            continue
+        group_id = row.get(NEMO_GYM_GROUP_ID_KEY)
+        generation_index = row.get(NEMO_GYM_ROLLOUT_INDEX_KEY)
+        if group_id is None or generation_index is None:
+            continue
+        group_attempt = row.get(NEMO_GYM_GROUP_ATTEMPT_KEY) or 0
+        row[_NG_ROLLOUT_ID_BODY_KEY] = (
+            f"{group_id}_g{generation_index}_t{group_attempt}"
+        )
+
