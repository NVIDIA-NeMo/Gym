+@pytest.mark.parametrize("debug_tokens", [False, True])
+def test_megatron_stager_echoes_staged_tokens_only_on_request(debug_tokens):
+    """Gym's model-call debug trace sets ``ng_debug_tokens`` in offload_params;
+    MInf merges the stager's response metadata into the HTTP response, so the
+    arrays it would otherwise drop for an offloaded payload reach Gym."""
+    from nemo_gym.token_id_capture.adapters.megatron import MegatronCaptureAdapter
+
+    stager = TQMegatronTokenStager(MagicMock(spec=TQTokenSink, media_pixel_dtype=None))
+    capture = MagicMock(adapter=MegatronCaptureAdapter())
+    capture.complete_call_from_response.return_value = MagicMock(
+        model_dump=lambda mode: {"disposition": "staged"}
+    )
+    stager._capture = capture
+    offload_params = {
+        "ng_capture": nemo_gym.CaptureAdmission(
+            rollout_id="r0", model_call_id="c1", mode="text"
+        ).model_dump(mode="json")
+    }
+    if debug_tokens:
+        offload_params["ng_debug_tokens"] = True
+
+    result = stager.stage(
+        "minf-response-1",
+        _minf_payload(multimodal=False),
+        finished_metadata=SimpleNamespace(policy_epoch=[(0, 0)]),
+        offload_params=offload_params,
+    )
+
+    expected = {"ng_commit_coords": {"disposition": "staged"}}
+    if debug_tokens:
+        expected["ng_debug_tokens"] = {
+            "prompt_token_ids": [10, 11],
+            "generation_token_ids": [12, 13],
+            "generation_log_probs": [-0.25, -0.5],
+            "error": None,
+        }
+    assert result.response_metadata == expected
+
+
+def test_megatron_stager_echo_reports_an_unreadable_payload():
+    from nemo_gym.token_id_capture.adapters.megatron import MegatronCaptureAdapter
+
+    stager = TQMegatronTokenStager(MagicMock(spec=TQTokenSink, media_pixel_dtype=None))
+    stager._capture = MagicMock(adapter=MegatronCaptureAdapter())
+    echo = stager._debug_tokens(_minf_payload_without("generated_log_probs"))
+    assert echo["prompt_token_ids"] == [10, 11]
+    assert echo["generation_token_ids"] is None
+    assert echo["error"].startswith("ValueError")
