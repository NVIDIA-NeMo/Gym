#
# Endpoint configuration for the recipes here. Copy to ./env.yaml in the Gym repo root
# (Gym auto-loads it) and fill in the placeholders. Never commit the filled-in copy.
#
# Only endpoints and keys belong here. Gym applies env.yaml over the recipe configs, so a
# sampling or benchmark setting added here would silently replace the published one.
#
# API keys come from your shell via ${oc.env:VAR}, listed in .env.example.

# The model under test. Base URL ends in /v1 — Gym appends /chat/completions.
#   local vLLM / SGLang:  http://localhost:8000/v1
policy_base_url: http://localhost:8000/v1
policy_api_key: ${oc.env:POLICY_API_KEY,dummy}
# Whatever name your endpoint serves the model under — it must match your deployment
# exactly. Serve with --reasoning-parser nemotron_v3: the recipes turn thinking on and
# expect the reasoning back in its own field.
policy_model_name: <your-model-id>

# Gated datasets (GPQA, HLE, MMLU-ProX, ...). Passed to Gym's prepare step.
hf_token: ${oc.env:HF_TOKEN,null}

# LLM judge for the judged recipes (HLE, AA-LCR, AA-Omniscience). Each recipe pins the judge
# model (gpt-5.6-luna) and how it calls it: HLE and AA-LCR use the Responses API
# (<judge_base_url>/responses), AA-Omniscience uses Chat Completions
# (<judge_base_url>/chat/completions). Check the recipe header for the request your endpoint
# must accept. Base URL ends in /v1, e.g. https://api.openai.com/v1.
judge_base_url: <judge-base-url>
judge_api_key: ${oc.env:JUDGE_API_KEY,null}
# Only if your endpoint serves that same model under a different id (applies to every recipe):
# judge_model_name: <your-id-for-gpt-5.6-luna>
#
# Wire judges only through these keys. A judge server block here (such as the judge_model or
# genrm_model block of a Lightning 3.5 env.yaml) silently replaces the judge a recipe pins.

# Tau3 user simulator (gpt-5.4-mini-2026-03-17, pinned in tau3.yaml). It uses the judge
# endpoint above (Chat Completions: <judge_base_url>/chat/completions) with its own key.
user_simulator_api_key: ${oc.env:SIM_KEY,null}
# Only if your endpoint serves that model under a different id:
# user_simulator_model_name: <your-id-for-gpt-5.4-mini-2026-03-17>
# Tau2 uses a different simulator (Qwen3-235B-A22B-Instruct-2507-FP8, pinned in tau2.yaml) on the
# same endpoint and key. Only if your endpoint serves it under a different id:
# tau2_user_simulator_model_name: <your-id-for-Qwen3-235B-A22B-Instruct-2507-FP8>

# CritPt grader (Artificial Analysis API). critpt.yaml parses the value: one key or a list.
artificial_analysis_api_key: ${oc.env:ARTIFICIAL_ANALYSIS_API_KEY,null}
