#
# Copy to `.env`, fill in what you need, and load it before running a recipe:
#
#   set -a; source .env; set +a
#
# Only the vars for the recipes you actually run matter — leave the rest as `???`
# (JUDGE_API_KEY: commented out). Endpoint URLs otherwise live in `env.yaml` (see
# env.yaml.example). Judge model ids are pinned in each recipe; set judge_model_name in
# env.yaml only to alias that same model for your provider.

# === Shared ===
# Dataset access. Accept the terms on the Hub first for gated datasets. env.yaml
# passes it to Gym as `hf_token`.
HF_TOKEN=???
# Policy key (env.yaml -> policy_api_key). Any value works for a local vLLM server.
POLICY_API_KEY=???

# === Judges (HLE, AA-LCR, AA-Omniscience) ===
# Key for the judge endpoint in env.yaml (judge_api_key). Uncomment it only when you run a
# judged recipe, and set a real key. Left unset, the judge fails at startup; ??? or an empty
# value passes validation and every judge call fails after the model has answered everything.
# JUDGE_API_KEY=

# === CritPt ===
# Artificial Analysis grading key (https://artificialanalysis.ai/documentation#critpt-api;
# env.yaml -> artificial_analysis_api_key). One key, or '[key1,key2]' (quoted, no spaces) to
# switch keys when one is rate-limited. critpt.yaml parses the value like a YAML value, so
# single-quote a key that contains '=' or is all digits or true/false, e.g. "['key=1']".
ARTIFICIAL_ANALYSIS_API_KEY=???

# === Run control (all recipes) ===
# Opt-in resume: continue an interrupted run in the same OUT dir. Gym resumes by
# skipping rows already present and fingerprints nothing — not the sampling params,
# not the dataset — so resuming into a dir written under a different config silently
# mixes the two.
# RESUME=1
# Recipes pin Gym to the commit their published number was produced with, which
# rewrites tracked files (never the recipes) — commit or stash your own work first, and
# run `git restore .` to undo. Set PIN_GYM=0 to run against your current checkout, or
# GYM_PIN to a different commit.
# PIN_GYM=0
# GYM_PIN=
