#
# Copy to `.env`, fill in what you need, and load it before running a recipe:
#
#   set -a; source .env; set +a
#
# Only the vars for the recipes you actually run matter — leave the rest as `???`.
# Endpoint URLs and judge model ids otherwise live in `env.yaml` (see
# env.yaml.example); PinchBench is the exception and takes its endpoints from here,
# because the agent that calls them never reads env.yaml.

# === Shared ===
# Dataset access. Accept the terms on the Hub first for gated datasets.
HF_TOKEN=???
# Policy key (env.yaml -> policy_api_key).
NVIDIA_API_KEY=???
# Judge gateway key (env.yaml -> judge_key). Also read directly by gdpval.
JUDGE_API_KEY=???
# Tau3's user simulator (env.yaml). Set it to the judge key if that is what you have.
SIM_KEY=???

# === Judge models ===
# These recipes share env.yaml's judge slot but each needs a different model, so the
# id is named per recipe rather than set once.
# aa-lcr — used: Qwen3-235B-A22B-Instruct-2507
AALCR_JUDGE_MODEL=???
# browsecomp — used: GLM-5.1
BROWSECOMP_JUDGE_MODEL=???

# === Web search (browsecomp, gdpval) ===
# One key, or a bracketed list to rotate across: [tvly-1,tvly-2]. Unbracketed commas
# are Hydra sweep syntax and abort the run at startup. Prefer the list for full runs:
# a rate-limited agent quietly makes fewer tool calls and scores lower.
TAVILY_API_KEY=???

# === BrowseComp ===
# Optional: the list of domains search skips. Defaults to the exclude_domains.json
# shipped next to the recipe. Swapping in a different list changes search coverage,
# so scores move with it.
# EXCLUDE_JSON=

# === CritPt ===
# Artificial Analysis grading API. One key, or a bracketed list to spread the daily
# quota — a full run needs one scoring per repeat.
ARTIFICIAL_ANALYSIS_API_KEY=???
# Optional. Submissions and grader responses are cached here (default
# <OUT>/critpt_cache) so a run that dies on quota can be re-scored without repeating
# inference. CRITPT_REPEATS is how many passes the interleaved dataset holds.
# CRITPT_CACHE_DIR=
# CRITPT_REPEATS=5

# === SciCode ===
# Path to the ~1 GB test_data.h5. Must be readable by whoever runs the recipe — an
# unreadable copy scores 0 with no error.
TEST_DATA=???

# === Tau3 ===
# All optional. GYM_ROOT defaults to $PWD (run from the Gym repo root), TAU2_VENV to
# $GYM_ROOT/responses_api_agents/tau2/.venv, and the data ref to the pinned fork branch.
# GYM_ROOT=
# TAU2_VENV=
# NEMO_GYM_TAU2_BENCH_DATA_REF=

# === GDPval ===
# The sandbox image from build-gdpval-sif.sh.
GDPVAL_CONTAINER_PATH=???
# Optional. Rubric is the default; comparison additionally needs GDPVAL_REFS pointing
# at a directory of reference deliverables. EXECUTE_ONLY produces deliverables without
# judging (that is how you build a reference set); JUDGE_ONLY re-scores existing ones.
# GDPVAL_REWARD_MODE=comparison
# GDPVAL_REFS=
# EXECUTE_ONLY=true
# JUDGE_ONLY=true
# Where deliverables are written (default <OUT>/deliverables) and the seed the judge
# panel is drawn with (default 42). GDPVAL_DEF only matters if the image definition is
# not at its usual place in your Gym checkout.
# PERSIST_DELIVERABLES_DIR=
# JUDGE_SAMPLING_SEED=42
# GDPVAL_DEF=

# === PinchBench ===
# This recipe never reads env.yaml — OpenClaw calls the endpoints itself — so its
# model and judge are configured here.
# Sandbox image. build_image.sh writes to this path too, so export it before building
# and one value covers both.
PINCHBENCH_SIF=???
# The endpoint OpenClaw calls. No default for the name: a wrong one silently scores a
# different model.
PINCHBENCH_MODEL_BASE_URL=???
PINCHBENCH_MODEL_API_KEY=???
PINCHBENCH_MODEL_NAME=???
# Judge — used: claude-haiku-4-5.
PINCHBENCH_JUDGE_MODEL=???
PINCHBENCH_JUDGE_BASE_URL=???
PINCHBENCH_JUDGE_API_KEY=???
# ONE key only: this field is a plain string, so a bracketed list is taken literally.
PINCHBENCH_TAVILY_API_KEY=???

# === Run control (all recipes) ===
# Opt-in resume: continue an interrupted run in the same OUT dir. Gym resumes by
# skipping rows already present and fingerprints nothing — not the sampling params,
# not the dataset — so resuming into a dir written under a different config silently
# mixes the two.
# RESUME=1
# Rollout retry budget, Gym's default is 3. Only PinchBench's published run raised it,
# and its recipe sets that itself — override here only if you want a different budget.
# NEMO_GYM_MAX_ROLLOUT_ATTEMPTS=
# Recipes pin Gym to the commit their tech report number was produced with, which
# rewrites tracked files (never the recipes) — commit or stash your own work first, and
# run `git restore .` to undo. Set PIN_GYM=0 to run against your current checkout, or
# GYM_PIN to a different commit.
# PIN_GYM=0
# GYM_PIN=
