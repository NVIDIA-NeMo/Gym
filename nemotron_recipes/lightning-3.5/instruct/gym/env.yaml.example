#
# Endpoint configuration for the recipes here. Copy to ./env.yaml in the directory
# you run them from (Gym auto-loads ./env.yaml from the cwd) and fill in the
# placeholders. Never commit the filled-in copy.
#
# Gym merges env.yaml over the benchmark config — only command-line ++ beats it — so
# these blocks wire each recipe's servers. Unused blocks are harmless: a benchmark
# only starts the servers it references.
#
# URLs and model ids go HERE; API keys come from your shell via ${oc.env:VAR}, listed
# in .env.example. A key you don't need resolves empty and only surfaces as a 401 if
# that judge is actually called.
#
# PinchBench is the exception: it reads none of this. OpenClaw calls the endpoints
# itself, so its model and judge are set in .env instead.

# ========================= FILL THESE IN =========================

# The model under test. Base URL ends in /v1 — Gym appends /chat/completions.
#   local vLLM / SGLang:  http://localhost:8000/v1
# Serving it yourself is the coherent default: the score-determining serving flags
# (--reasoning-parser, --kv-cache-dtype fp8, --max-model-len) can only be set that way.
policy_base_url: http://localhost:8000/v1
policy_api_key: ${oc.env:NVIDIA_API_KEY}
# Whatever name your endpoint serves the model under — the recipes pass it straight
# through, so it must match your deployment exactly.
#
# Serve with --reasoning-parser nemotron_v3: enable_thinking and skip_special_tokens
# only behave as in the published runs on that template plus parser. GDPval is the
# exception — its reference used a parser plugin that is not public, so its numbers
# depend on something you cannot reproduce exactly here.
policy_model_name: <your-model-id>

# Default sampling for the model under test. Some recipes adjust this per benchmark
# (aa-lcr's top_p, browsecomp's and omniscience's token caps).
responses_create_params:
  temperature: 1.0
  top_p: 0.95

# Judge gateway. The blocks below inherit these two, so set them once. The endpoint
# must be OpenAI-compatible and serve the judge models pinned below; if your judges
# live on different providers, replace ${judge_url}/${judge_key} per block.
judge_url: "<judge-base-url>"                 # e.g. https://api.openai.com/v1
judge_key: ${oc.env:JUDGE_API_KEY,""}
tavily_api_key: ${oc.env:TAVILY_API_KEY,""}
artificial_analysis_api_key: ${oc.env:ARTIFICIAL_ANALYSIS_API_KEY,""}

# ===================== WIRING (don't rename) =====================
# These block names are Gym server ids fixed by the benchmark configs. Each pins the
# judge MODEL the published runs used — keep the model, adjusting only the id to
# however your provider routes it.

# HLE judge — used: gpt-4o. Without this block HLE grades with the model under test,
# which is the benchmark config's default.
judge_model:
  responses_api_models:
    openai_model:
      openai_base_url: ${judge_url}
      openai_model: gpt-4o
      openai_api_key: ${judge_key}

# AA-Omniscience judge — used: gemini-3-flash-preview.
genrm_model:
  responses_api_models:
    openai_model:
      openai_base_url: ${judge_url}
      openai_model: gemini-3-flash-preview
      openai_api_key: ${judge_key}

# Shared judge slot for aa-lcr and browsecomp, which need DIFFERENT models — each
# recipe pins its own via AALCR_JUDGE_MODEL / BROWSECOMP_JUDGE_MODEL, so only the
# endpoint and key belong here.
Qwen3-235B-A22B-Instruct-2507-FP8:
  responses_api_models:
    vllm_model:
      base_url: ${judge_url}
      api_key: ${judge_key}

# Tau3 user simulator — plays the customer, so its identity is part of the benchmark.
# Used: gpt-5.4-mini. Key comes from SIM_KEY.
gpt-5_4-mini-2026-03-17:
  responses_api_models:
    openai_model:
      openai_base_url: ${judge_url}
      openai_model: gpt-5.4-mini
      openai_api_key: ${oc.env:SIM_KEY,""}

# GDPval judges. Deliverables are graded by a panel — GPT-5.5, Gemini 3.1 Pro and
# Claude Opus 4.8, one sampled per call — and all three route through this one block,
# so the endpoint has to serve all of them. The model id below is only the fallback
# used when the panel is disabled.
gdpval_judge_model:
  responses_api_models:
    openai_model:
      openai_base_url: ${judge_url}
      openai_model: gemini-3.1-pro-preview
      openai_api_key: ${judge_key}

# GDPval's pinned benchmark config does not declare this setting, so the user-owned
# env overlay supplies it after the recipe restores the pinned Gym revision.
gdpval_stirrup_agent:
  responses_api_agents:
    stirrup_agent:
      tavily_api_key: ${oc.env:TAVILY_API_KEY,""}
