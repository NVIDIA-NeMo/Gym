# Endpoint configuration for the recipes here. Copy to ./env.yaml in the Gym repo root
# (Gym auto-loads it) and fill in the blocks for the recipes you run. Never commit the
# filled-in copy.
#
# Only endpoints and keys belong here: Gym applies env.yaml over the recipe configs, so any
# other setting added here silently replaces the published one. Keys come from .env.
#
# Base URLs end in /v1 (e.g. https://api.openai.com/v1). Each recipe pins its judge model;
# the commented *_model_name lines only rename that same model if your provider serves it
# under a different id.

# ============================ MODEL UNDER TEST ============================
# Serve it as in reproducibility.md, "Serving the model"; the name must match your
# deployment exactly (the command there serves it under this name).
policy_base_url: http://localhost:8000/v1
policy_api_key: ${oc.env:POLICY_API_KEY,dummy}
policy_model_name: nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-BF16

# Gated Hugging Face datasets: GPQA, HLE (text-only and full).
hf_token: ${oc.env:HF_TOKEN,null}

# ========================== JUDGES AND SIMULATORS ==========================
# One OpenAI-compatible gateway for every judge and user simulator below; each recipe pins
# its own model. If one of them lives elsewhere, uncomment its base_url and api_key lines.
judge_base_url: <judge-base-url>
judge_api_key: ${oc.env:JUDGE_API_KEY,null}

# HLE (text-only and full). Judge: gpt-5.6-luna, Responses API.
# hle_judge_base_url: <judge-base-url>
# hle_judge_api_key: ${oc.env:HLE_JUDGE_API_KEY,null}
# hle_judge_model_name: gpt-5.6-luna

# AA-LCR. Judge: gpt-5.6-luna, Responses API.
# aalcr_judge_base_url: <judge-base-url>
# aalcr_judge_api_key: ${oc.env:AALCR_JUDGE_API_KEY,null}
# aalcr_judge_model_name: gpt-5.6-luna

# AA-Omniscience. Judge: gpt-5.6-luna, Chat Completions.
# omniscience_judge_base_url: <judge-base-url>
# omniscience_judge_api_key: ${oc.env:OMNISCIENCE_JUDGE_API_KEY,null}
# omniscience_judge_model_name: gpt-5.6-luna

# BrowseComp. Judge: GLM-5.1, Chat Completions.
# browsecomp_judge_base_url: <judge-base-url>
# browsecomp_judge_api_key: ${oc.env:BROWSECOMP_JUDGE_API_KEY,null}
# browsecomp_judge_model_name: zai-org/GLM-5.1

# GDPval-AA v2. Judge: gemini-3.1-pro-preview (every panel call), Chat Completions.
# gdpval_judge_base_url: <judge-base-url>
# gdpval_judge_api_key: ${oc.env:GDPVAL_JUDGE_API_KEY,null}
# gdpval_judge_gemini_model: gemini-3.1-pro-preview

# Tau2. User simulator: Qwen3-235B-A22B-Instruct-2507-FP8, Chat Completions.
# tau2_user_simulator_base_url: <simulator-base-url>
# tau2_user_simulator_api_key: ${oc.env:TAU2_USER_SIMULATOR_API_KEY,null}
# tau2_user_simulator_model_name: Qwen/Qwen3-235B-A22B-Instruct-2507-FP8

# Tau3-Banking. User simulator: gpt-5.4-mini-2026-03-17, Chat Completions.
# tau3_user_simulator_base_url: <simulator-base-url>
# tau3_user_simulator_api_key: ${oc.env:TAU3_USER_SIMULATOR_API_KEY,null}
# tau3_user_simulator_model_name: gpt-5.4-mini-2026-03-17

# ============================== OTHER SERVICES ==============================
# CritPt grader (Artificial Analysis API) and BrowseComp web search (Exa).
artificial_analysis_api_key: ${oc.env:ARTIFICIAL_ANALYSIS_API_KEY,null}
exa_api_key: ${oc.env:EXA_API_KEY,null}
