#
# Copy to `.env`, fill in what you need, and load it before running a recipe:
#
#   set -a; source .env; set +a
#
# Only the vars for the recipes you actually run matter — leave the rest as `???`.
# Endpoint URLs live in `env.yaml` (see env.yaml.example).

# === Shared ===
# Dataset access. Accept the terms on the Hub first for gated datasets. env.yaml
# passes it to Gym as `hf_token`.
HF_TOKEN=???
# Policy key (env.yaml -> policy_api_key). Any value works for a local vLLM server.
POLICY_API_KEY=???

# === Judges and user simulators ===
# Key for the shared judge gateway (env.yaml -> judge_api_key). If a recipe's judge has its
# own endpoint in env.yaml, add its key too, e.g. HLE_JUDGE_API_KEY, AALCR_JUDGE_API_KEY,
# OMNISCIENCE_JUDGE_API_KEY, BROWSECOMP_JUDGE_API_KEY, GDPVAL_JUDGE_API_KEY,
# TAU2_USER_SIMULATOR_API_KEY, TAU3_USER_SIMULATOR_API_KEY.
JUDGE_API_KEY=???

# === BrowseComp ===
# Exa search key (https://exa.ai; env.yaml -> exa_api_key).
EXA_API_KEY=???

# === GDPval-AA v2 ===
# Tavily web search key for the agent (https://tavily.com). For a full run give several,
# '[key-1,key-2]': a single key rate-limits and the agent then cannot search.
TAVILY_API_KEY=???

# === SciCode ===
# Path of SciCode's test_data.h5 (reproducibility.md, "SciCode" has the download).
TEST_DATA=???

# === CritPt ===
# Artificial Analysis grading key (https://artificialanalysis.ai/documentation#critpt-api;
# env.yaml -> artificial_analysis_api_key). One key, or '[key1,key2]' (quoted, no spaces) to
# switch keys when one is rate-limited. critpt.yaml parses the value like a YAML value, so
# single-quote a key that contains '=' or is all digits or true/false, e.g. "['key=1']".
ARTIFICIAL_ANALYSIS_API_KEY=???

# === SWE-bench, Terminal-Bench 2.1 ===
# Your self-hosted OpenSandbox server (reproducibility.md, "SWE-bench Verified, Multilingual
# and Pro"): its address (e.g. 127.0.0.1:8080) and the api_key from its sandbox.toml.
OPENSANDBOX_DOMAIN=???
OPENSANDBOX_API_KEY=???
# SWE-bench only: absolute path of the folder you downloaded OpenCode into (glibc/ and musl/
# inside; reproducibility.md has the download).
OPENCODE_DIR=???
