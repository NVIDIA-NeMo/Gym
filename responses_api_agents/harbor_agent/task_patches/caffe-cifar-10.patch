--- a/tasks/caffe-cifar-10/solution/solve.sh
+++ b/tasks/caffe-cifar-10/solution/solve.sh
@@ -37,6 +37,13 @@
 sed -i 's/solver_mode: GPU/solver_mode: CPU/' examples/cifar10/cifar10_quick_solver.prototxt
 sed -i 's/max_iter: 4000/max_iter: 500/' examples/cifar10/cifar10_quick_solver.prototxt
 
-./data/cifar10/get_cifar10.sh
+# Upstream get_cifar10.sh fetches www.cs.toronto.edu -> 301 -> cave.cs.toronto.edu,
+# which TCP-RSTs this cluster's egress IP. Use a byte-identical mirror (md5 verified).
+curl -fSL --retry 5 --retry-all-errors -o /tmp/cifar-10-binary.tar.gz \
+  https://data.brainchip.com/dataset-mirror/cifar10/cifar-10-binary.tar.gz
+echo "c32a1d4ab5d03f1284b67883e8d87530  /tmp/cifar-10-binary.tar.gz" | md5sum -c -
+mkdir -p data/cifar10
+tar -xf /tmp/cifar-10-binary.tar.gz -C data/cifar10 --strip-components=1
+rm -f /tmp/cifar-10-binary.tar.gz
 ./examples/cifar10/create_cifar10.sh
 ./examples/cifar10/train_quick.sh 2>&1 | tee training_output.txt
