# Real sudo refuses to run here: it requires /etc/sudoers to be owned by uid 0,
# and it cannot setuid to an unmapped uid in our single-uid user namespace.
export SAAS_FAKE_ID=1
# sudo without -u means root. Reporting the old fallback uid 999 here makes
# supervisors believe they are already non-root, so their own setuid() calls
# fail before workers can be spawned.
user="root"
while [ "$#" -gt 0 ]; do
  case "$1" in
    -u|-U)
      user="${2:-}"
      shift 2
      ;;
    -g|-C|-p|-h|-r|-t|-T)
      shift 2
      ;;
    --user=*)
      user="${1#--user=}"
      shift
      ;;
    --group=*|--prompt=*|--host=*)
      shift
      ;;
    -E|-H|-n|-S|-b|-i|-s|-k|-K)
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      shift
      ;;
    *)
      break
      ;;
  esac
done

# Report the uid the image gave that account; tools that map the effective uid
# back to a name fail when it is absent from /etc/passwd.
case "$user" in
  *[!0-9]*)
    uid="$(awk -F: -v u="$user" '$1 == u { print $3 }' /etc/passwd 2>/dev/null)"
    ;;
  *) uid="$user" ;;
esac
# Export rather than only writing the per-pid file, so forked children inherit it.
export SAAS_FORCE_UID="${uid:-999}"
echo "$SAAS_FORCE_UID" > "/tmp/.saas-euid-$$"

[ "$#" -gt 0 ] || exec /bin/sh
case "$1" in
  *=*) exec env "$@" ;;
esac
exec "$@"
