# Copyright: SaaS-Bench Authors; see bundled licenses.
# Vendored for native benchmark evaluation; original behavior retained.
export SAAS_FAKE_ID=1
user="${1%%:*}"
shift
case "$user" in
  ''|*[!0-9]*)
    # Report the uid the image gave that account; tools that map the effective
    # uid back to a name fail when it is absent from /etc/passwd.
    uid="$(awk -F: -v u="$user" '$1 == u { print $3 }' /etc/passwd 2>/dev/null)"
    ;;
  *) uid="$user" ;;
esac
# Export rather than only writing the per-pid file, so forked children inherit it.
export SAAS_FORCE_UID="${uid:-999}"
echo "$SAAS_FORCE_UID" > /tmp/.saas-euid-$$
[ $# -gt 0 ] || exec /bin/sh
exec "$@"
