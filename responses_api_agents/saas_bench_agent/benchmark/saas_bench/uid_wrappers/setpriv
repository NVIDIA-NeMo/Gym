#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Source: https://github.com/bpritam14/Gym-evaluation/blob/e8bdaf19ba99ec4f4fb689980d46bb6e2829ac2d/responses_api_agents/saas_bench_agent/benchmark/saas_bench/uid_wrappers/setpriv
# Copyright: SaaS-Bench Authors; see bundled licenses.
# Vendored for native benchmark evaluation; original behavior retained.
export SAAS_FAKE_ID=1
user=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --reuid)
      user="${2:-}"
      shift 2
      ;;
    --reuid=*)
      user="${1#--reuid=}"
      shift
      ;;
    --regid|--groups)
      shift 2
      ;;
    --init-groups|--clear-groups|--no-new-privs)
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      shift
      ;;
    *)
      break
      ;;
  esac
done

# Report the uid the image gave that account, and export it so forked children
# inherit it rather than falling back to real root.
case "$user" in
  ''|*[!0-9]*)
    uid="$(awk -F: -v u="$user" '$1 == u { print $3 }' /etc/passwd 2>/dev/null)"
    ;;
  *) uid="$user" ;;
esac
export SAAS_FORCE_UID="${uid:-999}"
echo "$SAAS_FORCE_UID" > "/tmp/.saas-euid-$$"

exec "$@"
