                }
              }
            },
            "additionalProperties": true
          },
          "sortBy": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {},
                "sort": {}
              },
              "additionalProperties": true
            }
          },
          "groupBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aggregations": {
            "type": "object",
            "properties": {
              "defaultAggregation": {
