        "summarizeErrors": {
          "type": "boolean",
          "required": false,
          "location": "query"
        },
        "unitdp": {
          "type": "integer",
          "required": false,
          "location": "query"
        }
      },
      "request": {
        "type": "object",
        "properties": {
          "Items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
