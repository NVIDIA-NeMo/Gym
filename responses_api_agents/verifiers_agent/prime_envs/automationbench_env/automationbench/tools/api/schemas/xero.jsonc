{
  "api": "xero",
  "endpoints": [
    {
      "id": "xero.invoices.list",
      "path": "xero/api.xro/2.0/Invoices",
      "method": "GET",
      "description": "Retrieve a paginated list of invoices and bills with optional filtering by status, contact, date, or keyword.",
      "parameters": {
        "where": {
          "type": "string",
          "description": "Filter expression (e.g., Status==\"AUTHORISED\" AND Type==\"ACCREC\").",
          "required": false,
          "location": "query"
        },
        "order": {
          "type": "string",
          "description": "Sort order (e.g., Date DESC, InvoiceNumber ASC).",
          "required": false,
          "location": "query"
        },
        "IDs": {
          "type": "string",
          "description": "Comma-separated list of InvoiceIDs to retrieve.",
          "required": false,
          "location": "query"
        },
        "InvoiceNumbers": {
          "type": "string",
          "description": "Comma-separated invoice numbers to filter by.",
          "required": false,
          "location": "query"
        },
        "ContactIDs": {
          "type": "string",
          "description": "Comma-separated ContactIDs to filter by.",
          "required": false,
          "location": "query"
        },
        "Statuses": {
          "type": "string",
          "description": "Comma-separated statuses to filter by (DRAFT, SUBMITTED, AUTHORISED, PAID, VOIDED, DELETED).",
          "required": false,
          "location": "query"
        },
        "page": {
          "type": "integer",
          "description": "Page number (100 records per page).",
          "required": false,
          "location": "query"
        },
        "includeArchived": {
          "type": "boolean",
          "required": false,
          "location": "query"
        },
        "summaryOnly": {
          "type": "boolean",
          "description": "Return lightweight records without line items or payments.",
          "required": false,
          "location": "query"
        },
        "searchTerm": {
          "type": "string",
          "description": "Free-text keyword filter for invoice records (ignores case).",
          "required": false,
          "location": "query"
        },
        "createdByMyApp": {
          "type": "boolean",
          "description": "Only return invoices created by the current OAuth app.",
          "required": false,
          "location": "query"
        },
        "unitdp": {
          "type": "integer",
          "description": "Decimal places for unit amounts (default 2, set to 4 for four).",
          "required": false,
          "location": "query"
        }
      },
      "response": "{Invoices: [Invoice]}"
    },
    {
      "id": "xero.invoices.get",
      "path": "xero/api.xro/2.0/Invoices/{InvoiceID}",
      "method": "GET",
      "description": "Fetch a single invoice or bill by its unique identifier, including full line items and payment history.",
      "parameters": {
        "InvoiceID": {
          "type": "string",
          "description": "UUID of the invoice to retrieve.",
          "required": true,
          "location": "path"
        },
        "unitdp": {
          "type": "integer",
          "required": false,
          "location": "query"
        }
      },
      "response": "{Invoices: [Invoice]}"
    },
    {
      "id": "xero.invoices.create",
      "path": "xero/api.xro/2.0/Invoices",
      "method": "PUT",
      "description": "Create one or more new invoices or bills. Each requires a Type (ACCREC for sales, ACCPAY for purchases), a Contact, and LineItems.",
      "parameters": {
        "summarizeErrors": {
          "type": "boolean",
          "description": "When false, returns individual validation errors per record.",
          "required": false,
          "location": "query"
        },
        "unitdp": {
          "type": "integer",
          "required": false,
          "location": "query"
        }
      },
      "request": {
        "additionalProperties": true,
        "properties": {
          "Invoices": {
            "items": {
              "additionalProperties": true,
              "properties": {
                "BrandingThemeID": {},
                "Contact": {
                  "additionalProperties": true,
                  "properties": {
                    "ContactID": {}
                  },
                  "type": "object"
                },
                "CurrencyCode": {},
                "CurrencyRate": {},
                "Date": {},
                "DueDate": {},
                "InvoiceNumber": {},
                "LineAmountTypes": {},
                "LineItems": {
                  "items": {
                    "additionalProperties": true,
                    "properties": {
                      "AccountCode": {},
                      "Description": {},
                      "ItemCode": {},
                      "Quantity": {},
                      "TaxType": {},
                      "Tracking": {},
                      "UnitAmount": {}
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "Reference": {},
                "Status": {},
                "Type": {},
                "Url": {}
              },
              "required": [
                "Contact",
                "LineItems",
                "Type"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "response": "{Invoices: [Invoice with InvoiceID]}"
    },
    {
      "id": "xero.invoices.update",
      "path": "xero/api.xro/2.0/Invoices/{InvoiceID}",
      "method": "POST",
      "description": "Modify an existing invoice or bill. Can update fields, change status (e.g., AUTHORISED, VOIDED, DELETED), or mark as sent.",
      "parameters": {
        "InvoiceID": {
          "type": "string",
          "description": "UUID of the invoice to update.",
          "required": true,
          "location": "path"
        },
        "unitdp": {
          "type": "integer",
          "required": false,
          "location": "query"
        }
      },
      "request": {
        "additionalProperties": true,
        "properties": {
          "Contact": {},
          "Date": {},
          "DueDate": {},
          "InvoiceNumber": {},
          "LineAmountTypes": {},
          "LineItems": {},
          "Reference": {},
          "SentToContact": {},
          "Status": {}
        },
        "type": "object"
      },
      "response": "{Invoices: [updated Invoice]}"
    },
    {
      "id": "xero.invoices.email",
      "path": "xero/api.xro/2.0/Invoices/{InvoiceID}/Email",
      "method": "POST",
      "description": "Send an invoice to the contact's email address. The invoice must be in AUTHORISED or SUBMITTED status.",
      "parameters": {
        "InvoiceID": {
          "type": "string",
          "required": true,
          "location": "path"
        }
      },
      "response": "204 No Content on success"
    },
    {
      "id": "xero.invoices.onlineUrl",
      "path": "xero/api.xro/2.0/Invoices/{InvoiceID}/OnlineInvoice",
      "method": "GET",
      "description": "Retrieve the URL for the online version of an invoice that can be shared with the customer.",
      "parameters": {
        "InvoiceID": {
          "type": "string",
          "required": true,
          "location": "path"
        }
      },
      "response": "{OnlineInvoices: [{OnlineInvoiceUrl: string}]}"
    },
    {
      "id": "xero.contacts.list",
      "path": "xero/api.xro/2.0/Contacts",
      "method": "GET",
      "description": "Retrieve a paginated list of contacts with optional filtering and search.",
      "parameters": {
        "where": {
          "type": "string",
          "description": "Filter expression (e.g., ContactStatus==\"ACTIVE\").",
          "required": false,
          "location": "query"
        },
        "order": {
          "type": "string",
          "required": false,
          "location": "query"
        },
        "IDs": {
          "type": "string",
          "description": "Comma-separated ContactIDs.",
          "required": false,
          "location": "query"
        },
        "page": {
          "type": "integer",
          "required": false,
          "location": "query"
        },
        "includeArchived": {
          "type": "boolean",
          "required": false,
          "location": "query"
        },
        "summaryOnly": {
          "type": "boolean",
          "required": false,
          "location": "query"
        },
        "searchTerm": {
          "type": "string",
          "description": "Searches across contact name, number, and email fields.",
          "required": false,
          "location": "query"
        }
      },
      "response": "{Contacts: [Contact]}"
    },
    {
      "id": "xero.contacts.get",
      "path": "xero/api.xro/2.0/Contacts/{ContactID}",
      "method": "GET",
      "description": "Fetch a single contact by its unique identifier, including addresses, phone numbers, and balances.",
      "parameters": {
        "ContactID": {
          "type": "string",
          "description": "UUID of the contact.",
          "required": true,
          "location": "path"
        }
      },
      "response": "{Contacts: [Contact]}"
    },
    {
      "id": "xero.contacts.create",
      "path": "xero/api.xro/2.0/Contacts",
      "method": "PUT",
      "description": "Create one or more new contacts. At minimum, a Name is required.",
      "parameters": {
        "summarizeErrors": {
          "type": "boolean",
          "required": false,
          "location": "query"
        }
      },
      "request": {
        "additionalProperties": true,
        "properties": {
          "Contacts": {
            "items": {
              "additionalProperties": true,
              "properties": {
                "AccountNumber": {},
                "AccountsPayableTaxType": {},
                "AccountsReceivableTaxType": {},
                "Addresses": {
                  "items": {
                    "additionalProperties": true,
                    "properties": {
                      "AddressLine1-4": {},
                      "AddressType": {},
                      "City": {},
                      "Country": {},
                      "PostalCode": {},
                      "Region": {}
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "BankAccountDetails": {},
                "CompanyNumber": {},
                "ContactNumber": {},
                "ContactPersons": {},
                "ContactStatus": {},
                "DefaultCurrency": {},
                "EmailAddress": {},
                "FirstName": {},
                "LastName": {},
                "Name": {},
                "PaymentTerms": {
                  "type": "object"
                },
                "Phones": {
                  "items": {
                    "additionalProperties": true,
                    "properties": {
                      "PhoneAreaCode": {},
                      "PhoneCountryCode": {},
                      "PhoneNumber": {},
                      "PhoneType": {}
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "PurchasesDefaultAccountCode": {},
                "SalesDefaultAccountCode": {},
                "TaxNumber": {}
              },
              "required": [
                "Name"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "response": "{Contacts: [Contact with ContactID]}"
    },
    {
      "id": "xero.contacts.update",
      "path": "xero/api.xro/2.0/Contacts/{ContactID}",
      "method": "POST",
      "description": "Modify an existing contact record.",
      "parameters": {
        "ContactID": {
          "type": "string",
          "required": true,
          "location": "path"
        }
      },
      "request": {
        "additionalProperties": true,
        "properties": {
          "Addresses": {},
          "ContactPersons": {},
          "ContactStatus": {},
          "DefaultCurrency": {},
          "EmailAddress": {},
          "FirstName": {},
          "LastName": {},
