    },
    {
      "id": "xero.payments.create",
      "path": "xero/api.xro/2.0/Payments",
      "method": "PUT",
      "description": "Record one or more payments against invoices or credit notes.",
      "parameters": {
        "summarizeErrors": {
          "type": "boolean",
          "required": false,
          "location": "query"
        }
      },
      "request": {
        "additionalProperties": true,
        "anyOf": [
          {
            "required": [
              "Payments"
            ]
          },
          {
            "properties": {
              "Amount": {
                "type": "number"
              },
              "Date": {
                "type": "string"
              }
            },
            "required": [
              "Amount",
              "Date"
            ]
          }
        ],
        "properties": {
          "Payments": {
            "items": {
              "additionalProperties": true,
              "properties": {
                "Account": {
                  "additionalProperties": true,
                  "properties": {
                    "AccountID": {}
                  },
                  "type": "object"
                },
                "Amount": {
                  "type": "number"
                },
                "CurrencyRate": {},
                "Date": {
                  "type": "string"
                },
                "Invoice": {
                  "additionalProperties": true,
                  "properties": {
                    "InvoiceID": {}
                  },
                  "type": "object"
                },
                "IsReconciled": {},
                "Reference": {}
              },
              "required": [
                "Amount",
                "Date"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "response": "{Payments: [Payment with PaymentID]}"
    },
    {
      "id": "xero.payments.delete",
