    {
      "id": "wave.transactions.create",
      "path": "wave/graphql/public",
      "method": "POST",
      "description": "Record a new categorised financial transaction with an anchor account and one or more line items. The anchor represents the primary bank or cash account, and line items split the amount across ledger accounts.",
      "parameters": {},
      "request": {
        "type": "object",
        "properties": {
          "businessId": {
            "type": "string"
          },
          "externalId": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "anchor": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string"
              },
              "amount": {
                "type": "number"
              },
              "direction": {}
            },
            "additionalProperties": true
          },
          "lineItems": {
            "type": "array",
            "items": {
              "type": "object",
