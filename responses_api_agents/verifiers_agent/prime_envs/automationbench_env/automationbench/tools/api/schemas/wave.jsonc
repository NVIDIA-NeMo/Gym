    {
      "id": "wave.invoices.create",
      "path": "wave/graphql/public",
      "method": "POST",
      "description": "Generate a new invoice for a customer. Requires the business ID, customer ID, and at least one line item with a product reference.",
      "parameters": {},
      "request": {
        "additionalProperties": true,
        "properties": {
          "amountTitle": {},
          "businessId": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "disableBankPayments": {
            "type": "boolean"
          },
          "disableCreditCardPayments": {
            "type": "boolean"
          },
          "dueDate": {
            "format": "date",
            "type": "string"
          },
          "footer": {},
          "hideAmount": {},
          "hideDescription": {},
          "hideName": {},
          "hidePrice": {},
          "hideUnit": {},
          "invoiceDate": {
            "format": "date",
            "type": "string"
          },
          "invoiceNumber": {},
          "itemTitle": {},
          "items": {
            "items": {
              "additionalProperties": true,
              "properties": {
                "description": {},
                "productId": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "taxes": {
                  "items": {
                    "additionalProperties": true,
                    "properties": {
                      "salesTaxId": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "unitPrice": {
                  "type": "number"
                }
              },
              "required": [
                "productId"
              ],
              "type": "object"
            },
            "type": "array",
            "minItems": 1
          },
          "memo": {},
          "poNumber": {},
          "priceTitle": {},
          "status": {},
          "subhead": {},
          "title": {},
          "unitTitle": {}
        },
        "required": [
          "businessId",
          "customerId",
          "items"
        ],
        "type": "object"
      },
      "response": "{invoiceCreate: {didSucceed: boolean, inputErrors: [{path, message, code}], invoice: Invoice}}"
    },
