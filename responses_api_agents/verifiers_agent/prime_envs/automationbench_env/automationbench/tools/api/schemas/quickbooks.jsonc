{
  "api": "quickbooks",
  "endpoints": [
    {
      "id": "quickbooks.query.get",
      "path": "quickbooks/v3/company/{companyId}/query",
      "method": "GET",
      "description": "Run a QuickBooks query supplied as a URL parameter. Supports SELECT * or COUNT(*), WHERE conditions joined by AND, LIKE and IN filters, ORDERBY, and pagination with STARTPOSITION and MAXRESULTS.",
      "parameters": {
        "companyId": {
          "type": "string",
          "description": "The QuickBooks company (realm) identifier.",
          "required": true,
          "location": "path"
        },
        "query": {
          "type": "string",
          "description": "Complete QuickBooks query statement.",
          "required": true,
          "location": "query"
        }
      },
      "response": "{QueryResponse: {entity_type: [records], startPosition: int, maxResults: int, totalCount: int}}",
      "internalPath": {
        "companyId": "workspace"
      }
    },
    {
      "id": "quickbooks.query",
      "path": "quickbooks/v3/company/{companyId}/query",
      "method": "POST",
      "description": "Run a QuickBooks query to find and filter entity records. Supports SELECT * or COUNT(*), WHERE conditions joined by AND, LIKE and IN filters, ORDERBY, and pagination with STARTPOSITION and MAXRESULTS. OR, joins, and grouping are not supported.",
      "parameters": {
        "companyId": {
          "type": "string",
          "description": "The QuickBooks company (realm) identifier.",
          "required": true,
          "location": "path"
        }
      },
      "request": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "response": "{QueryResponse: {entity_type: [records], startPosition: int, maxResults: int, totalCount: int}}",
      "internalPath": {
        "companyId": "workspace"
      }
    },
    {
      "id": "quickbooks.customer.get",
      "path": "quickbooks/v3/company/{companyId}/customer/{customerId}",
      "method": "GET",
      "description": "Look up one customer record by ID, returning all of its fields.",
      "parameters": {
        "companyId": {
          "type": "string",
          "description": "The QuickBooks company identifier.",
          "required": true,
          "location": "path"
        },
        "customerId": {
          "type": "string",
          "description": "Unique ID of the customer to retrieve.",
          "required": true,
          "location": "path"
        }
      },
      "response": "Customer object",
      "internalPath": {
        "companyId": "workspace"
      }
    },
    {
      "id": "quickbooks.customer.create",
      "path": "quickbooks/v3/company/{companyId}/customer",
      "method": "POST",
      "description": "Add a new customer record. DisplayName must not duplicate any existing customer, vendor, or employee name.",
      "parameters": {
        "companyId": {
          "type": "string",
          "description": "The QuickBooks company identifier.",
          "required": true,
          "location": "path"
        }
      },
      "request": {
        "additionalProperties": true,
        "properties": {
          "Active": {},
          "BillAddr": {},
          "BillWithParent": {},
          "CompanyName": {},
          "CurrencyRef": {},
          "DefaultTaxCodeRef": {},
          "DisplayName": {},
          "FamilyName": {},
          "Fax": {},
          "GivenName": {},
          "Job": {},
          "MiddleName": {},
          "Mobile": {},
          "Notes": {},
          "ParentRef": {},
          "PaymentMethodRef": {},
          "PreferredDeliveryMethod": {},
          "PrimaryEmailAddr": {},
          "PrimaryPhone": {},
          "PrintOnCheckName": {},
          "SalesTermRef": {},
          "ShipAddr": {},
          "Suffix": {},
          "Taxable": {},
          "Title": {},
          "WebAddr": {}
        },
        "required": [
          "DisplayName"
        ],
        "type": "object"
      },
      "response": "{Customer: Customer object with Id}",
      "internalPath": {
        "companyId": "workspace"
      },
      "forbiddenBody": [
        "Id",
        "SyncToken"
      ]
    },
    {
      "id": "quickbooks.customer.update",
      "path": "quickbooks/v3/company/{companyId}/customer",
      "method": "POST",
      "description": "Modify an existing customer. The request body must include Id and the current SyncToken. Supports sparse updates when sparse is set to true.",
      "parameters": {
        "companyId": {
          "type": "string",
          "description": "The QuickBooks company identifier.",
          "required": true,
          "location": "path"
        }
      },
      "request": {
        "additionalProperties": true,
        "properties": {
          "Active": {},
          "BillAddr": {},
          "CompanyName": {},
          "DisplayName": {},
          "FamilyName": {},
          "GivenName": {},
          "Id": {},
          "Notes": {},
          "PrimaryEmailAddr": {},
          "PrimaryPhone": {},
          "ShipAddr": {},
          "SyncToken": {},
          "sparse": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "SyncToken"
        ],
        "type": "object"
      },
      "response": "{Customer: updated Customer object}",
      "internalPath": {
        "companyId": "workspace"
