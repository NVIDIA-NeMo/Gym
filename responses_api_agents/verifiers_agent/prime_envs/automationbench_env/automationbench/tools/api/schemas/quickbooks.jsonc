      "method": "POST",
      "description": "Bundle several create, read, update, delete, or query calls into one HTTP round-trip. Each batch item specifies an entity, operation, and payload. Maximum of 30 items per batch.",
      "parameters": {
        "companyId": {
          "type": "string",
          "required": true,
          "location": "path"
        }
      },
      "request": {
        "type": "object",
        "properties": {
          "BatchItemRequest": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bId": {
                  "type": "string"
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "create",
                    "update",
                    "delete",
                    "query"
                  ]
                },
                "Entity_Type": {
                  "type": "object",
                  "properties": {
                    "entity": {}
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "response": "{BatchItemResponse: [{bId, Entity_Type or Fault}]}",
      "internalPath": {
        "companyId": "workspace"
      }
    },
