          "type": "string",
          "required": true,
          "location": "path",
          "default": "me"
        },
        "id": {
          "type": "string",
          "description": "Identifier of the draft to replace.",
          "required": true,
          "location": "path"
        }
      },
      "request": {
        "additionalProperties": true,
        "properties": {
          "message": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "type": "object"
      },
      "response": "Draft: {id, message: {id, threadId, labelIds: [DRAFT]}}",
      "internalPath": {
        "userId": "me"
      }
    },
    {
      "id": "gmail.users.drafts.send",
      "path": "gmail/v1/users/{userId}/drafts/send",
      "method": "POST",
      "description": "Deliver the specified draft as a sent message.",
      "parameters": {
        "userId": {
          "type": "string",
          "required": true,
          "location": "path",
