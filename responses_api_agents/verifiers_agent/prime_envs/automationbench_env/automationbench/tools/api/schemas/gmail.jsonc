{
  "api": "gmail",
  "endpoints": [
    {
      "id": "gmail.users.messages.list",
      "path": "gmail/v1/users/{userId}/messages",
      "method": "GET",
      "description": "Retrieve messages from the user's mailbox, optionally narrowed by label, sender, subject, or a search query.",
      "parameters": {
        "userId": {
          "type": "string",
          "description": "The user's email address. Use 'me' to refer to the authenticated user.",
          "required": true,
          "location": "path",
          "default": "me"
        },
        "q": {
          "type": "string",
          "description": "Filter messages by a query string. Supports Gmail search operators (from:, to:, subject:, is:unread, label:, etc.).",
          "required": false,
          "location": "query"
        },
        "labelIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Restrict results to messages that carry all of the specified label IDs.",
          "required": false,
          "location": "query"
        },
        "maxResults": {
          "type": "integer",
          "description": "Upper limit on messages to return (default 100, max 500).",
          "required": false,
          "location": "query"
        },
        "includeSpamTrash": {
          "type": "boolean",
          "description": "When true, also returns messages from the SPAM and TRASH folders.",
          "required": false,
          "location": "query"
        }
      },
      "response": "ListMessagesResponse: {messages: [{id, threadId}], resultSizeEstimate: int}",
      "internalPath": {
        "userId": "me"
      }
    },
    {
      "id": "gmail.users.messages.get",
      "path": "gmail/v1/users/{userId}/messages/{id}",
      "method": "GET",
      "description": "Fetch a specific email message by its ID.",
      "parameters": {
        "userId": {
          "type": "string",
          "required": true,
          "location": "path",
          "default": "me"
        },
        "id": {
          "type": "string",
          "description": "Unique identifier of the message to fetch.",
          "required": true,
          "location": "path"
        },
        "format": {
          "type": "string",
          "enum": [
            "full",
            "minimal",
            "raw",
            "metadata"
          ],
          "description": "Response format: full (default), minimal, raw, or metadata.",
          "required": false,
          "location": "query"
        }
      },
      "response": "Message object with full payload",
      "internalPath": {
        "userId": "me"
      }
    },
    {
      "id": "gmail.users.messages.send",
      "path": "gmail/v1/users/{userId}/messages/send",
      "method": "POST",
      "description": "Compose and deliver an email. Provide exactly one message representation: raw must be the base64url encoding of a complete RFC 2822 message with a To header, other headers, a blank line, and the body; payload must include a non-empty To header and base64url-encoded body.data or parts[].body.data. Use base64_encode to produce encoded values.",
      "parameters": {
        "userId": {
          "type": "string",
          "required": true,
          "location": "path",
          "default": "me"
        }
      },
      "request": {
        "additionalProperties": false,
        "properties": {
          "payload": {
            "oneOf": [
              {
                "required": [
                  "body"
                ]
              },
              {
                "required": [
                  "parts"
                ]
              }
            ],
            "properties": {
              "body": {
                "properties": {
                  "data": {
                    "minLength": 1,
                    "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}(?:==)?|[A-Za-z0-9_-]{3}=?)?$",
                    "type": "string"
                  }
                },
                "required": [
                  "data"
                ],
                "type": "object"
              },
              "headers": {
                "contains": {
                  "properties": {
                    "name": {
                      "enum": [
                        "TO",
                        "To",
                        "tO",
                        "to"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "minLength": 1,
                      "pattern": "\\S",
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "type": "object"
                },
                "items": {
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "parts": {
                "items": {
                  "properties": {
                    "body": {
                      "properties": {
                        "data": {
                          "minLength": 1,
                          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}(?:==)?|[A-Za-z0-9_-]{3}=?)?$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "data"
                      ],
                      "type": "object"
                    },
                    "mimeType": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "body"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "headers"
            ],
            "type": "object"
          },
          "threadId": {
            "type": "string"
          },
          "raw": {
            "minLength": 1,
            "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}(?:==)?|[A-Za-z0-9_-]{3}=?)?$",
            "type": "string"
          }
        },
        "oneOf": [
          {
            "required": [
              "payload"
            ]
          },
          {
            "required": [
              "raw"
            ]
          }
        ],
        "type": "object"
      },
      "response": "Sent Message with id, threadId, labelIds",
      "internalPath": {
        "userId": "me"
      }
    },
    {
      "id": "gmail.users.messages.delete",
      "path": "gmail/v1/users/{userId}/messages/{id}",
      "method": "DELETE",
      "description": "Permanently and irrecoverably destroy a specific message from the mailbox.",
      "parameters": {
        "userId": {
          "type": "string",
          "required": true,
          "location": "path",
          "default": "me"
        },
        "id": {
          "type": "string",
          "required": true,
          "location": "path"
        }
      },
      "response": "Empty (204 No Content)",
      "internalPath": {
        "userId": "me"
      }
    },
    {
      "id": "gmail.users.messages.trash",
      "path": "gmail/v1/users/{userId}/messages/{id}/trash",
      "method": "POST",
      "description": "Send a message to the Trash folder by applying the TRASH label and removing the INBOX label.",
      "parameters": {
        "userId": {
          "type": "string",
          "required": true,
          "location": "path",
          "default": "me"
        },
        "id": {
          "type": "string",
          "required": true,
          "location": "path"
        }
      },
      "response": "Message with updated labelIds",
      "internalPath": {
        "userId": "me"
      }
    },
    {
      "id": "gmail.users.messages.untrash",
      "path": "gmail/v1/users/{userId}/messages/{id}/untrash",
      "method": "POST",
      "description": "Move a trashed message back to the inbox.",
      "parameters": {
        "userId": {
          "type": "string",
          "required": true,
          "location": "path",
          "default": "me"
        },
        "id": {
          "type": "string",
          "required": true,
          "location": "path"
        }
      },
      "response": "Message with updated labelIds",
      "internalPath": {
        "userId": "me"
      }
    },
    {
      "id": "gmail.users.messages.modify",
      "path": "gmail/v1/users/{userId}/messages/{id}/modify",
      "method": "POST",
      "description": "Add or remove labels on a specific message. Useful for archiving, toggling read/unread state, or applying custom labels.",
      "parameters": {
        "userId": {
          "type": "string",
          "required": true,
          "location": "path",
          "default": "me"
        },
        "id": {
          "type": "string",
          "required": true,
          "location": "path"
        }
      },
      "request": {
        "additionalProperties": true,
        "properties": {
          "addLabelIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "removeLabelIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "response": "Message with updated labelIds",
      "internalPath": {
        "userId": "me"
      }
    },
    {
      "id": "gmail.users.drafts.list",
      "path": "gmail/v1/users/{userId}/drafts",
      "method": "GET",
