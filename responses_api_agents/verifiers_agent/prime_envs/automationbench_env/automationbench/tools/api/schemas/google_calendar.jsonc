                  },
                  "dateTime": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "timeZone": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            ]
          },
          "startDateTime": {
            "minLength": 1,
            "type": "string"
          },
          "start__dateTime": {
            "minLength": 1,
            "type": "string"
          }
        },
