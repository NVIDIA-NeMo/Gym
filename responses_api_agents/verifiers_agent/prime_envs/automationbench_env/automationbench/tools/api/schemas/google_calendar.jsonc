                    ]
                  },
                  {
                    "required": [
                      "dateTime"
                    ]
                  }
                ],
                "properties": {
                  "date": {
                    "minLength": 1,
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                    "type": "string"
                  },
                  "dateTime": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "timeZone": {
