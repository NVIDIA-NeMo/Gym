        "company_id": {
          "type": "integer",
          "required": true,
          "location": "path"
        },
        "limit": {
          "type": "integer",
          "description": "Number of results per page (default 60).",
          "location": "query"
        },
        "page": {
          "type": "integer",
          "description": "Page number (default 1).",
          "location": "query"
        },
        "query": {
          "type": "string",
          "description": "Search locations by name.",
          "location": "query"
        },
        "scope": {
          "type": "string",
          "enum": [
            "active",
            "archived",
            "all"
          ],
          "description": "Filter by location status (default all).",
          "location": "query"
        },
        "view_mode": {
          "type": "string",
          "enum": [
            "brief",
            "full"
          ],
          "description": "Amount of detail returned (default brief).",
          "location": "query"
        }
