{
  "api": "recruitee",
  "endpoints": [
    {
      "id": "recruitee.offers.list",
      "path": "recruitee/v1/c/{company_id}/offers",
      "method": "GET",
      "description": "Retrieve all offers (jobs and talent pools) for the company.",
      "parameters": {
        "company_id": {
          "type": "integer",
          "description": "Company ID or subdomain.",
          "required": true,
          "location": "path"
        },
        "scope": {
          "type": "string",
          "enum": [
            "active",
            "archived",
            "closed",
            "draft",
            "published"
          ],
          "description": "Filter offers by their current status.",
          "location": "query"
        },
        "view_mode": {
          "type": "string",
          "enum": [
            "brief",
            "full"
          ],
          "description": "Level of detail in the response.",
          "location": "query"
        }
      },
      "response": "{offers: [Offer, ...]}",
      "internalPath": {
        "company_id": "workspace"
      }
    },
    {
      "id": "recruitee.offers.get",
      "path": "recruitee/v1/c/{company_id}/offers/{id}",
      "method": "GET",
      "description": "Retrieve details for a single offer by its ID.",
      "parameters": {
        "company_id": {
          "type": "integer",
          "required": true,
          "location": "path"
        },
        "id": {
          "type": "string",
          "description": "Offer ID or slug.",
          "required": true,
          "location": "path"
        }
      },
      "response": "{offer: Offer}",
      "internalPath": {
        "company_id": "workspace"
      }
    },
    {
      "id": "recruitee.offers.create",
      "path": "recruitee/v1/c/{company_id}/offers",
      "method": "POST",
      "description": "Create a new job posting or talent pool.",
      "parameters": {
        "company_id": {
          "type": "integer",
          "required": true,
          "location": "path"
        }
      },
      "request": {
        "additionalProperties": true,
        "properties": {
          "offer": {
            "additionalProperties": true,
            "properties": {
              "kind": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title"
            ],
            "type": "object"
          }
        },
        "type": "object"
      },
      "response": "{offer: Offer with id, pipeline_template, stages, followers}",
      "internalPath": {
        "company_id": "workspace"
      }
    },
    {
      "id": "recruitee.offers.update",
      "path": "recruitee/v1/c/{company_id}/offers/{id}",
      "method": "PATCH",
      "description": "Modify an existing offer's details.",
      "parameters": {
        "company_id": {
          "type": "integer",
          "required": true,
          "location": "path"
        },
        "id": {
          "type": "string",
          "description": "Offer ID.",
          "required": true,
          "location": "path"
        }
      },
      "request": {
        "additionalProperties": true,
        "properties": {
          "offer": {
            "additionalProperties": true,
            "properties": {
              "department_id": {},
              "description": {},
              "hybrid": {},
              "location_ids": {},
              "on_site": {},
              "remote": {},
              "requirements": {},
              "status": {},
              "title": {}
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "response": "{offer: Offer}",
      "internalPath": {
        "company_id": "workspace"
      }
    },
    {
      "id": "recruitee.offers.delete",
      "path": "recruitee/v1/c/{company_id}/offers/{id}",
