                "type": "string"
              },
              "emails": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "links": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "name": {
                "type": "string"
              },
              "phones": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "remote_cv_url": {
                "type": "string"
              },
              "social_links": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "offers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "response": "201 Created: {candidate: Candidate}",
      "internalPath": {
        "company_id": "workspace"
      }
    },
