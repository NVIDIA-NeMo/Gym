    {
      "id": "recruitee.candidates.search",
      "path": "recruitee/v1/c/{company_id}/search/new/candidates",
      "method": "GET",
      "description": "Advanced candidate search with structured filters and aggregations.",
      "parameters": {
        "company_id": {
          "type": "integer",
          "required": true,
          "location": "path"
        },
        "limit": {
          "type": "integer",
          "description": "Results per page (default 60, max 10000).",
          "location": "query"
        },
        "page": {
          "type": "integer",
          "description": "Page number (default 1).",
          "location": "query"
        },
        "filters_json": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "JSON-encoded array of filter conditions.",
          "location": "query"
        },
        "sort_by": {
          "type": "string",
          "enum": [
            "relevance_asc",
            "relevance_desc",
            "created_at_asc",
            "created_at_desc",
            "candidate_name_asc",
            "candidate_name_desc",
            "candidate_rating_asc",
            "candidate_rating_desc",
            "candidate_positive_ratings_asc",
            "candidate_positive_ratings_desc",
            "candidate_job_title_asc",
            "candidate_job_title_desc",
            "candidate_stage_name_asc",
            "candidate_stage_name_desc",
            "gdpr_expires_at_asc",
            "gdpr_expires_at_desc"
          ],
          "description": "Field and direction to sort results by (default created_at_desc).",
          "location": "query"
        }
      },
      "response": "{hits: [{id, name, emails, phones, rating, positive_ratings, placements, tags, created_at, ...}], total, aggregations}",
      "internalPath": {
        "company_id": "workspace"
      }
    },
