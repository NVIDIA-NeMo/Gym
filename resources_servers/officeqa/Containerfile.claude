ARG DOCUMENT_TOOLS_IMAGE
FROM node:24.22.1-trixie-slim@sha256:43b9ba1142b8dcf33fa8f922ca1be85714adc444e0586c7cf7726daaeabc1bea AS cli
ARG CLAUDE_CODE_VERSION=2.1.285
RUN npm install --prefix /opt/claude --omit=dev @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

FROM ${DOCUMENT_TOOLS_IMAGE}
ARG CLAUDE_CODE_VERSION=2.1.285
COPY --from=cli /usr/local/bin/node /usr/local/bin/node
COPY --from=cli /opt/claude /opt/claude
RUN set -eu; mkdir -p /opt/cli; \
    ln -s /opt/claude/node_modules/@anthropic-ai/claude-code/bin/claude.exe /opt/cli/claude; \
    /opt/cli/claude --version | grep -Fx "${CLAUDE_CODE_VERSION} (Claude Code)"; \
    sha256sum /opt/cli/claude; \
    chmod -R a+rX /opt/claude; \
    chown -R 65534:65534 /workspace/task
USER 65534:65534
