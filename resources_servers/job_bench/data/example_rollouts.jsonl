)\nprint(wb.sheetnames)\nws = wb[wb.sheetnames[0]]\nprint(ws.max_row, ws.max_column)\nfor i, row in enumerate(ws.iter_rows(values_only=True)):\n    print(row)\n    if i > 8: break\nEOF\n['Sheet1']\n801 9\n('APID', 'Vendor', 'InvoiceDate', 'DueDate', 'Amount', 'Currency', 'Status', 'PaidDate', 'Terms')\n('AP10000', 'BluePrints', datetime.datetime(2024, 12, 16, 0, 0), datetime.datetime(2025, 1, 15, 0, 0), 344.25, 'EUR', 'Open', None, 'Net 30')\n('AP10001', 'BluePrints', datetime.datetime(2024, 5, 18, 0, 0), datetime.datetime(2024, 6, 17, 0, 0), 3298.38, 'CAD', 'Partial', None, 'Net 30')\n('AP10002', 'Fast Travel', datetime.datetime(2024, 2, 25, 0, 0), datetime.datetime(2024, 3, 26, 0, 0), 1023.43, 'GBP', 'Open', None, 'Net 30')\n('AP10003', 'ABC Supplies', datetime.datetime(2024, 1, 8, 0, 0), datetime.datetime(2024, 2, 7, 0, 0), 4433.05, 'USD', 'Partial', None, 'Net 30')\n('AP10004', 'ABC Supplies', datetime.datetime(2024, 5, 23, 0, 0), datetime.datetime(2024, 6, 22, 0, 0), 4345.14, 'GBP', 'Partial', None, 'Net 30')\n('AP10005', 'Fast Travel', datetime.datetime(2024, 7, 9, 0, 0), datetime.datetime(2024, 8, 8, 0, 0), 1599.18, 'AUD', 'Open', None, 'Net 30')\n('AP10006', 'BluePrints', datetime.datetime(2024, 12, 20, 0, 0), datetime.datetime(2025, 1, 19, 0, 0), 894.13, 'USD', 'Open', None, 'Net 30')\n('AP10007', 'Fast Travel', datetime.datetime(2024, 9, 25, 0, 0), datetime.datetime(2024, 10, 25, 0, 0), 1303.06, 'GBP', 'Paid', datetime.datetime(2024, 10, 25, 0, 0), 'Net 30')\n('AP10008', 'ABC Supplies', datetime.datetime(2024, 2, 12, 0, 0), datetime.datetime(2024, 3, 13, 0, 0), 3481.8, 'CAD', 'Paid', datetime.datetime(2024, 3, 13, 0, 0), 'Net 30')\n\u001b[0m\n\u001b[0m$ \u001b[0mpython3 - <<'EOF'\nimport openpyxl\nfrom datetime import datetime\nfrom collections import Counter\nwb = openpyxl.load_workbook('/tmp/Accounts-Payable.xlsx', data_only=True)\nws = wb['Sheet1']\nrows = list(ws.iter_rows(values_only=True))[1:]\nprint(\"total:\", len(rows))\nprint(\"vendors:\", Counter(r[1] for r in rows))\nprint(\"status:\", Counter(r[6] for r in rows))\nprint(\"currencies:\", Counter(r[5] for r in rows))\n# invoices with invoice date in Q1 2024\nq1 = [r for r in rows if isinstance(r[2], datetime) and datetime(2024,1,1) <= r[2] <= datetime(2024,3,31)]\nprint(\"invoiced Q1-2024:\", len(q1))\n# invoices due on/before 3/31\ndue = [r for r in rows if isinstance(r[3], datetime) and r[3] <= datetime(2024,3,31)]\nprint(\"due by 3/31/2024:\", len(due), \"of which status:\", Counter(r[6] for r in due))\n# Paid in Q1\npaidq1 = [r for r in rows if isinstance(r[7], datetime) and datetime(2024,1,1) <= r[7] <= datetime(2024,3,31)]\nprint(\"paid in Q1-2024:\", len(paidq1))\nfor r in sorted(paidq1, key=lambda r: r[7]):\n    print(r[0], r[1], r[2].strftime('%Y-%m-%d'), r[3].strftime('%Y-%m-%d'), f\"{r[4]:>9.2f}\", r[5], r[6], r[7].strftime('%Y-%m-%d'))\n# Open/Partial as of 3/31 (invoice date <= 3/31, status not Paid or Paid but PaidDate > 3/31)\nopen331 = []\nfor r in rows:\n    if not isinstance(r[2], datetime) or r[2] > datetime(2024,3,31): continue\n    st = r[6]; pd_ = r[7]\n    if st in ('Open','Partial') or (st == 'Paid' and isinstance(pd_, datetime) and pd_ > datetime(2024,3,31)):\n        open331.append(r)\nprint(\"open as of 3/31:\", len(open331))\nfor r in sorted(open331, key=lambda r: r[3]):\n    print(r[0], r[1], r[2].strftime('%Y-%m-%d'), r[3].strftime('%Y-%m-%d'), f\"{r[4]:>9.2f}\", r[5], r[6], r[7].strftime('%Y-%m-%d') if r[7] else '-')\nEOF\ntotal: 800\nvendors: Counter({'BluePrints': 182, 'Global Office': 165, 'ABC Supplies': 157, 'TechMart': 157, 'Fast Travel': 139})\nstatus: Counter({'Partial': 276, 'Open': 267, 'Paid': 257})\ncurrencies: Counter({'USD': 175, 'GBP': 173, 'AUD': 169, 'CAD': 145, 'EUR': 138})\ninvoiced Q1-2024: 76\ndue by 3/31/2024: 376 of which status: Counter({'Paid': 133, 'Partial': 131, 'Open': 112})\npaid in Q1-2024: 26\nAP10752 Global Office 2023-12-02 2024-01-01   1377.49 AUD Paid 2024-01-01\nAP10136 BluePrints 2023-12-