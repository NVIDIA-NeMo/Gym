RUN mkdir -p /app /app/src
WORKDIR /app
COPY Cargo.toml Cargo.toml
ENV RUST_BACKTRACE=1
RUN mkdir -p /app/src
RUN echo "use actix_web::App; fn main() { App::new() }" > src/main.rs
# Lock crates that still build on Rust 1.83 (the newest actix dependencies need a newer rustc): a newer
# cargo resolves with rust-version 1.83, the image keeps 1.83. Upstream's prebuild of a dummy main that
# does not compile follows unchanged; it caches the compiled dependencies.
RUN cp Cargo.toml Cargo.toml.orig \
    && sed -i '/^\[package\]/a rust-version = "1.83"' Cargo.toml \
    && rustup toolchain install 1.86.0 --profile minimal \
    && CARGO_RESOLVER_INCOMPATIBLE_RUST_VERSIONS=fallback cargo +1.86.0 generate-lockfile \
    && rustup toolchain uninstall 1.86.0 \
    && mv Cargo.toml.orig Cargo.toml
RUN cargo build || echo "Build failed"

