, 214), 'fg': (200, 110, 40)},\\n    'prosperity': {'zh': '\\u606d\\u559c\\u53d1\\u8d22', 'en': 'Wish You Prosperity', 'bg': (250, 215, 215), 'fg': (180, 40, 40)},\\n    'everything_needs': {'zh': '\\u5e94\\u6709\\u5c3d\\u6709', 'en': 'Have Everything One Needs', 'bg': (214, 236, 236), 'fg': (30, 120, 120)},\\n    'dazzling_array': {'zh': '\\u7433\\u7405\\u6ee1\\u76ee', 'en': 'A Dazzling Array of Beautiful Things', 'bg': (245, 222, 240), 'fg': (150, 70, 140)},\\n    'mountains_water': {'zh': '\\u9ad8\\u5c71\\u6d41\\u6c34', 'en': 'Lofty Mountains and Flowing Water', 'bg': (215, 232, 244), 'fg': (50, 100, 150)},\\n    'learning_no_end': {'zh': '\\u5b66\\u65e0\\u6b62\\u5883', 'en': 'Learning Has No End', 'bg': (233, 242, 219), 'fg': (90, 130, 50)},\\n    'stars_moon': {'zh': '\\u4f17\\u661f\\u6367\\u6708', 'en': 'Stars Surround the Moon', 'bg': (210, 218, 240), 'fg': (60, 70, 140)},\\n    'lanterns': {'zh': '\\u5f20\\u706f\\u7ed3\\u5f69', 'en': 'Decked Out in Lanterns and Decorations', 'bg': (250, 220, 215), 'fg': (190, 60, 50)},\\n    'accents': {'zh': '\\u5357\\u8154\\u5317\\u8c03', 'en': 'A Mix of Different Accents', 'bg': (238, 233, 214), 'fg': (130, 110, 40)},\\n    'birdsong_flowers': {'zh': '\\u9e1f\\u8bed\\u82b1\\u9999', 'en': 'Birdsong and Fragrant Flowers', 'bg': (224, 242, 225), 'fg': (60, 140, 80)},\\n    'bamboo_shoots': {'zh': '\\u96e8\\u540e\\u6625\\u7b0b', 'en': 'Spring Bamboo Shoots After Rain', 'bg': (218, 238, 224), 'fg': (50, 130, 80)},\\n    'firewood_cauldron': {'zh': '\\u91dc\\u5e95\\u62bd\\u85aa', 'en': 'Take Away the Firewood from Under the Cauldron', 'bg': (243, 227, 210), 'fg': (140, 90, 40)},\\n    'acme_perfection': {'zh': '\\u7089\\u706b\\u7eaf\\u9752', 'en': 'Reach the Acme of Perfection', 'bg': (215, 235, 245), 'fg': (40, 120, 170)},\\n    'stage_costume': {'zh': '\\u7c89\\u58a8\\u767b\\u573a', 'en': 'Take the Stage in Costume', 'bg': (242, 220, 235), 'fg': (150, 60, 120)},\\n    # animals\\n    'dinosaur': {'zh': '\\u6050\\u9f99', 'en':