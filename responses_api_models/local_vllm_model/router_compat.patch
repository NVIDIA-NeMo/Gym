new file mode 100644
index 0000000..a82ef66
--- /dev/null
+++ b/src/policies/session_balanced.rs
@@ -0,0 +1,117 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+//! Bounded, lifetime-sticky session assignment for one static worker pool.
+//!
+//! New sessions use the healthy worker with the fewest assigned sessions;
+//! subsequent turns retain their exact worker regardless of request load.
+//! There is deliberately no eviction or health fallback: losing affinity is
+//! not silently presented as a continuation of the same experiment. Restart
+//! the run-owned router to change membership or reclaim the bounded table.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+
+use super::{get_healthy_worker_indices, LoadBalancingPolicy, RequestHeaders};
+use crate::core::Worker;
+use crate::metrics::RouterMetrics;
+
+const MAX_SESSIONS: usize = 65_536;
+const MAX_SESSION_BYTES: usize = 1_024;
+
+#[derive(Debug)]
+struct Pool {
+    urls: Vec<String>,
+    pins: HashMap<String, String>,
+    assigned: HashMap<String, usize>,
+}
+
+#[derive(Debug)]
+pub struct SessionBalancedPolicy {
+    pool: Mutex<Option<Pool>>,
+    capacity: usize,
+}
+
+impl SessionBalancedPolicy {
+    pub fn new() -> Self {
+        Self {
+            pool: Mutex::new(None),
+            capacity: MAX_SESSIONS,
+        }
+    }
+}
+
+impl LoadBalancingPolicy for SessionBalancedPolicy {
+    fn select_worker_with_headers(
+        &self,
+        workers: &[Arc<dyn Worker>],
+        _request_text: Option<&str>,
+        headers: Option<&RequestHeaders>,
+    ) -> Option<usize> {
+        let session = headers?.get("x-session-id")?;
+        if session.trim().is_empty() || session.len() > MAX_SESSION_BYTES {
+            return None;
+        }
+        let healthy = get_healthy_worker_indices(workers);
+        if healthy.is_empty() {
+            tracing::warn!(workers = workers.len(), "Session-balanced pool has no available worker");
+            return None;
+        }
+        let mut urls: Vec<_> = workers.iter().map(|w| w.url().to_owned()).collect();
+        urls.sort();
+        urls.dedup();
+        if urls.len() != workers.len() {
+            return None;
+        }
+        let mut guard = self.pool.lock().ok()?;
+        let pool = guard.get_or_insert_with(|| Pool {
+            assigned: urls.iter().map(|url| (url.clone(), 0)).collect(),
+            urls: urls.clone(),
+            pins: HashMap::new(),
+        });
+        if pool.urls != urls {
+            tracing::warn!(expected = pool.urls.len(), actual = urls.len(), "Session-balanced registry membership changed");
+            return None;
+        }
+        let index = if let Some(pinned) = pool.pins.get(session) {
+            // Do not remap an existing episode when its worker goes unhealthy.
+            match healthy.iter().find(|&&i| workers[i].url() == pinned) {
+                Some(&index) => index,
+                None => {
+                    tracing::warn!(worker = %pinned, "Session-balanced pinned worker unavailable; refusing remap");
+                    return None;
+                }
+            }
+        } else {
+            if pool.pins.len() >= self.capacity {
+                return None;
+            }
+            let index = *healthy
+                .iter()
+                .min_by_key(|&&i| (pool.assigned[workers[i].url()], workers[i].url()))?;
+            let url = workers[index].url();
+            *pool.assigned.get_mut(url)? += 1;
+            pool.pins.insert(session.clone(), url.to_owned());
+            index
+        };
+        let url = workers[index].url();
+        RouterMetrics::record_processed_request(url);
+        RouterMetrics::record_policy_decision(self.name(), url);
+        Some(index)
+    }
+
+    fn name(&self) -> &'static str {
+        "session_balanced"
+    }
+    fn needs_headers(&self) -> bool {
+        true
+    }
+    fn requires_full_worker_pool(&self) -> bool {
+        true
+    }
+    fn as_any(&self) -> &dyn std::any::Any {
+        self
+    }
+    fn reset(&self) {
+        *self.pool.lock().expect("session pool lock poisoned") = None;
+    }
+}
