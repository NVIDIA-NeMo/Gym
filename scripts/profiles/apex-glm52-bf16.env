# GLM-5.2 BF16: one vLLM endpoint spans 4, 8, or 16 four-GPU nodes. Each node
# hosts one TP=4 data-parallel rank, and Ray connects all ranks.
POLICY_LABEL="GLM-5.2 BF16"
POLICY_SERVE_SCRIPT=${APEX_GYM_DIR}/scripts/serve_apex_glm52_bf16_replica.sh
POLICY_LB_SCRIPT=/lustre/fsw/portfolios/llmservice/users/spanev/gdpval_colo/bin/gdpval_lb.py
POLICY_LB_PYTHON=${APEX_GYM_DIR}/.venv/bin/python

MODEL_NAME=GLM-52-bf16-parallel
MODEL_PATH=/lustre/fsw/portfolios/llmservice/users/venkats/models/GLM-5.2
CONTAINER_IMAGE=/lustre/fsw/portfolios/llmservice/users/mengxiwu/containers/vllm-glm52-arm64-cu130-ray.sqsh
APEX_AGENT_SUPPORTS_VISION=false

# The shared rollout harness validates LAUNCHER_PATH for policy profiles. GLM
# starts vLLM directly in POLICY_SERVE_SCRIPT, so this points to that wrapper.
LAUNCHER_PATH=${POLICY_SERVE_SCRIPT}

GLM52_NUM_NODES=${GLM52_NUM_NODES:-16}
NODES_PER_REPLICA=${GLM52_NUM_NODES}
GPUS_PER_NODE=4
TENSOR_PARALLEL_SIZE=4
PIPELINE_PARALLEL_SIZE=1
DATA_PARALLEL_SIZE=${GLM52_NUM_NODES}
DATA_PARALLEL_SIZE_LOCAL=1
BASE_RAY_PORT=6379
BASE_API_PORT=10240

GPU_MEMORY_UTILIZATION=0.85
API_SERVER_COUNT=1
MAX_MODEL_LEN=262144

CACHE_ROOT=/lustre/fsw/portfolios/llmservice/users/${USER_NAME}/cache
HF_HOME=${CACHE_ROOT}/huggingface
VLLM_CACHE_ROOT=${CACHE_ROOT}/vllm

# The policy step and every node-local Gym worker share each 144-CPU node.
K3_CPUS_PER_NODE=40
GYM_CPUS_PER_NODE=96
GYM_HEAD_PORT=20000

# Current vLLM emits the Responses API `reasoning` field. GLM uses the glm45
# reasoning parser and glm47 tool-call parser in the serving wrapper.
NEMO_GYM_REASONING_FIELD=reasoning
USES_REASONING_PARSER=true
USES_INTERLEAVED_REASONING=true
SERVE_WAIT_SECONDS=3600
