# Kimi-K3: one replica spans four 4-GPU nodes with TP=16. This profile follows
# the serving contract used by gdpval_colo/unified/gdpval_rollout.sbatch.
POLICY_SERVE_SCRIPT=/lustre/fsw/portfolios/llmservice/users/spanev/gdpval_colo/bin/serve_k3_replica.sh
POLICY_LB_SCRIPT=/lustre/fsw/portfolios/llmservice/users/spanev/gdpval_colo/bin/gdpval_lb.py
POLICY_LB_PYTHON=${APEX_GYM_DIR}/.venv/bin/python

MODEL_NAME=moonshotai/Kimi-K3
MODEL_PATH=/lustre/fs1/portfolios/llmservice/projects/llmservice_modelalignment_ppo/users/pjin/checkpoints/kimi-k3-hf
CONTAINER_IMAGE=/lustre/fs1/portfolios/llmservice/projects/llmservice_modelalignment_ppo/users/pjin/containers/vllm-openai-kimi-k3-e90e2603-20260727.sqsh
LAUNCHER_PATH=/lustre/fsw/portfolios/llmservice/users/spanev/kimi_k3/serve_k3.sh

NODES_PER_REPLICA=4
GPUS_PER_NODE=4
TENSOR_PARALLEL_SIZE=16
BASE_API_PORT=12500

# Serving values validated by the GDPVal collocated K3 profile.
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=262144
MAX_NUM_BATCHED_TOKENS=16384
MAX_NUM_SEQS=64

# Colocated node budget: the K3 Slurm step is capped at 40 CPUs and the
# node-local Gym/Apptainer collector at 96, leaving eight CPUs per node free.
K3_CPUS_PER_NODE=40
GYM_CPUS_PER_NODE=96
GYM_HEAD_PORT=20000

# K3 accepts either reasoning field alone but rejects sending both aliases.
NEMO_GYM_REASONING_FIELD=reasoning
USES_REASONING_PARSER=true
USES_INTERLEAVED_REASONING=true
SERVE_WAIT_SECONDS=3600
