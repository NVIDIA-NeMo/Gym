# Copy to .env and fill in. Loaded automatically by agent.py via python-dotenv.

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional override — any OpenRouter model slug. Defaults to the free
# nvidia/nemotron-3-ultra-550b-a55b:free if unset, so running this costs nothing beyond Tavily calls.
OPENROUTER_MODEL=

# Tavily — https://app.tavily.com
TAVILY_API_KEY=

# Optional — LangSmith tracing (https://smith.langchain.com). Picked up automatically by
# LangChain/LangGraph once set, no code changes needed.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Optional — only used by config_tavily_search.yaml's judge_model, via OpenRouter (reuses
# OPENROUTER_API_KEY above). Defaults to anthropic/claude-sonnet-4.5 if unset — deliberately a
# stronger, different model than the agent's free default, since a judge scoring another model's
# answers generally shouldn't be that same (or a weaker) model.
SEARCH_JUDGE_MODEL=
